+			if (broadsword_waitforshot->integer==2)
+			{
+				if (!(ghoul2.mFlags&(GHOUL2_RAG_COLLISION_DURING_DEATH|GHOUL2_RAG_COLLISION_SLIDE)))
+				{
+					//nothing was encountered, lets just wait for the first shot
+					return; // we ain't starting yet
+				}
+			}
+			else
