+/*
+** InitOpenGL
+**
+** This function is responsible for initializing a valid OpenGL subsystem.  This
+** is done by calling GLimp_Init (which gives us a working OGL subsystem) then
+** setting variables, checking GL constants, and reporting the gfx system config
+** to the user.
+*/
+static void InitOpenGL( void )
+{
+	//
+	// initialize OS specific portions of the renderer
+	//
+	// GLimp_Init directly or indirectly references the following cvars:
+	//		- r_fullscreen
+	//		- r_mode
+	//		- r_(color|depth|stencil)bits
+	//		- r_ignorehwgamma
+	//		- r_gamma
+	//
+
+	if ( glConfig.vidWidth == 0 )
+	{
+		windowDesc_t windowDesc = { GRAPHICS_API_GENERIC };
+		memset(&glConfig, 0, sizeof(glConfig));
+
+		window = ri.WIN_Init(&windowDesc, &glConfig);
+		kt::g_logCallback = [](const char* msg) { ri.Printf(PRINT_ALL, "%s", msg); };
+		if (!window.handle || !kt::R_Init(window.handle, glConfig.vidWidth, glConfig.vidHeight))
+		{
+			Com_Error(ERR_FATAL, "KatarnEngine could not start Direct3D 12 (see katarn_log.txt). Set cl_renderer rdsp-vanilla to use OpenGL.");
+		}
+		glConfig.colorBits = 32;
+		glConfig.depthBits = 24;
+		glConfig.stencilBits = 8;
+		glConfig.deviceSupportsGamma = qfalse;   // r_gamma is applied when the frame is presented
+
+		// get our config strings
+		glConfig.vendor_string = (const char *)qglGetString (GL_VENDOR);
+		glConfig.renderer_string = (const char *)qglGetString (GL_RENDERER);
+		glConfig.version_string = (const char *)qglGetString (GL_VERSION);
+		glConfig.extensions_string = (const char *)qglGetString (GL_EXTENSIONS);
+
+		// OpenGL driver constants
+		qglGetIntegerv( GL_MAX_TEXTURE_SIZE, &glConfig.maxTextureSize );
+
+		// stubbed or broken drivers may have reported 0...
+		glConfig.maxTextureSize = Q_max(0, glConfig.maxTextureSize);
+
+		// initialize extensions
+		GLimp_InitExtensions( );
+
+		// set default state
+		GL_SetDefaultState();
+		R_Splash();	//get something on screen asap
+	}
+	else
+	{
+		// set default state
+		GL_SetDefaultState();
+	}
+}
