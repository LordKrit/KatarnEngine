+static inline void DestroyGoreTexCoordinates(int tag)
+{
+	GoreTextureCoordinates *gTC = FindGoreRecord(tag);
+	if (!gTC)
+	{
+		return;
+	}
+	(*gTC).~GoreTextureCoordinates();
+	//I don't know what's going on here, it should call the destructor for
