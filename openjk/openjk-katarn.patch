+static uint32_t generateHashValueForText( const char *string, size_t length )
+{
+	int i = 0;
+	uint32_t hash = 0;
+
+	while ( length-- )
+	{
+		hash += string[i] * (i + 119);
+		i++;
+	}
+
+	return (hash ^ (hash >> 10) ^ (hash >> 20));
+}
