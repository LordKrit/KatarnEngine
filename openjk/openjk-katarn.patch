+void R_TakeScreenshotPNG( int x, int y, int width, int height, char *fileName ) {
+	byte *buffer=NULL;
+	size_t offset=0;
+	int padlen=0;
+
+	buffer = RB_ReadPixels( x, y, width, height, &offset, &padlen );
