+// KatarnEngine - HD worlds: GPU-resident world-space clusters with LOD chains and bindless PBR materials (.kworld v2)
+#include "kt_world.h"
+#include "kt_render.h"
+#include "kworld_format.h"
+#include "../tr_local.h"
+#include <math.h>
+#include <stdio.h>
+#include <vector>
+#include <string>
+#include <algorithm>
+
+namespace kt {
+
+static struct World {
+	bool active = false;
+	std::string name;
+	Buffer vb, ib, materials;
+	std::vector<Texture> textures;
+	std::vector<KwCluster> clusters;
+	std::vector<KwLod> lods;
+	std::vector<KwMaterial> mats;
+	std::vector<KwLight> lights;
+	WorldEnv env;
+	ID3D12PipelineState* gbPSO[3] = {};          // per cluster class
+	ID3D12PipelineState* shPSO[2] = {};          // opaque, alpha-tested
+	ID3D12PipelineState* fxPSO = nullptr;
+	bool hasFX = false;         // water / flowing water into the HDR scene
+	Shader vs, ps, shadowPS, fxPS;
+	bool pipelines = false;
+	float bmin[3], bmax[3];
+	uint64_t drawnTris = 0;
+	uint32_t drawnClusters = 0;
+} W;
+
+static WorldEnv defaultEnv;
+static cvar_t* kt_lodError = nullptr;
+static cvar_t* kt_lodLock = nullptr;
+static cvar_t* kt_worldPath = nullptr;
+
+bool World_Active() { return W.active; }
+const WorldEnv& World_Env() { return W.active ? W.env : defaultEnv; }
+
+static const D3D12_INPUT_ELEMENT_DESC kWorldLayout[] = {
+	{ "POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+	{ "NORMAL", 0, DXGI_FORMAT_R16G16_SNORM, 0, 12, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+	{ "TANGENT", 0, DXGI_FORMAT_R16G16_SNORM, 0, 16, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+	{ "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 20, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+	{ "BLENDINDICES", 0, DXGI_FORMAT_R16G16_UINT, 0, 28, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+};
+
+static D3D12_SHADER_BYTECODE BCode(const Shader& s)
+{
+	D3D12_SHADER_BYTECODE b = {};
+	if (s.ok) { b.pShaderBytecode = s.blob->GetBufferPointer(); b.BytecodeLength = s.blob->GetBufferSize(); }
+	return b;
+}
+
+static bool CreateWorldPipelines()
+{
+	if (W.pipelines) return true;
+	kt_lodError = ri.Cvar_Get("kt_lodError", "1.0", CVAR_ARCHIVE);
+	kt_lodLock = ri.Cvar_Get("kt_lodLock", "-1", 0);
+	kt_worldPath = ri.Cvar_Get("kt_worldPath", "", CVAR_ARCHIVE);   // extra folder holding <map>.kworld (checked first)
+	W.vs = R_Shader("world", "VS", "vs_5_1");
+	W.ps = R_Shader("world", "PS", "ps_5_1");
+	W.shadowPS = R_Shader("world", "ShadowPS", "ps_5_1");
+	W.fxPS = R_Shader("world", "FxPS", "ps_5_1");
+	if (!W.vs.ok || !W.ps.ok) return false;
+	D3D12_GRAPHICS_PIPELINE_STATE_DESC d = {};
+	d.SampleMask = 0xffffffff;
+	d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+	d.RasterizerState.FrontCounterClockwise = TRUE;
+	d.RasterizerState.DepthClipEnable = TRUE;
+	for (auto& rt : d.BlendState.RenderTarget) rt.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL, rt.SrcBlend = D3D12_BLEND_ONE,
+		rt.DestBlend = D3D12_BLEND_ZERO, rt.BlendOp = D3D12_BLEND_OP_ADD, rt.SrcBlendAlpha = D3D12_BLEND_ONE, rt.DestBlendAlpha = D3D12_BLEND_ZERO,
+		rt.BlendOpAlpha = D3D12_BLEND_OP_ADD, rt.LogicOp = D3D12_LOGIC_OP_NOOP;
+	d.DepthStencilState.DepthEnable = TRUE;
+	d.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ALL;
+	d.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_GREATER_EQUAL;
+	d.InputLayout = { kWorldLayout, 5 };
+	d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+	d.SampleDesc.Count = 1;
+	d.VS = BCode(W.vs); d.PS = BCode(W.ps);
+	d.NumRenderTargets = 3;
+	d.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB; d.RTVFormats[1] = DXGI_FORMAT_R16G16B16A16_FLOAT; d.RTVFormats[2] = DXGI_FORMAT_R11G11B10_FLOAT;
+	d.DSVFormat = DXGI_FORMAT_D32_FLOAT;
+	for (int c = 0; c < 3; c++) {
+		d.RasterizerState.CullMode = c == KWC_OPAQUE ? D3D12_CULL_MODE_BACK : D3D12_CULL_MODE_NONE;
+		W.gbPSO[c] = CreateGraphicsPSO(d, "world gbuffer");
+	}
+	// shadows: two-sided (Blender scenes are full of single-sided walls), slope-scaled bias
+	d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+	d.RasterizerState.DepthBias = 1000; d.RasterizerState.SlopeScaledDepthBias = 2.0f; d.RasterizerState.DepthBiasClamp = 0.01f;
+	d.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_LESS_EQUAL;
+	d.NumRenderTargets = 0;
+	for (auto& f : d.RTVFormats) f = DXGI_FORMAT_UNKNOWN;
+	d.PS = D3D12_SHADER_BYTECODE{};
+	W.shPSO[0] = CreateGraphicsPSO(d, "world shadow");
+	d.PS = BCode(W.shadowPS);
+	W.shPSO[1] = CreateGraphicsPSO(d, "world shadow alpha");
+	// FX: no depth buffer (the shader tests against the scene depth and reads it for absorption); rgb + dst * a
+	if (W.fxPS.ok) {
+		D3D12_GRAPHICS_PIPELINE_STATE_DESC f = d;
+		f.RasterizerState.DepthBias = 0; f.RasterizerState.SlopeScaledDepthBias = 0; f.RasterizerState.DepthBiasClamp = 0;
+		f.DepthStencilState.DepthEnable = FALSE;
+		f.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+		f.DSVFormat = DXGI_FORMAT_UNKNOWN;
+		f.NumRenderTargets = 1;
+		f.RTVFormats[0] = DXGI_FORMAT_R16G16B16A16_FLOAT;
+		auto& rt = f.BlendState.RenderTarget[0];
+		rt.BlendEnable = TRUE; rt.SrcBlend = D3D12_BLEND_ONE; rt.DestBlend = D3D12_BLEND_SRC_ALPHA; rt.BlendOp = D3D12_BLEND_OP_ADD;
+		rt.SrcBlendAlpha = D3D12_BLEND_ZERO; rt.DestBlendAlpha = D3D12_BLEND_ONE; rt.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+		rt.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+		f.PS = BCode(W.fxPS);
+		W.fxPSO = CreateGraphicsPSO(f, "world fx");
+	}
+	W.pipelines = true;
+	return W.gbPSO[0] && W.shPSO[0];
+}
+
+void World_Unload()
+{
+	if (!W.active && W.textures.empty()) return;
+	WaitIdle();
+	DestroyBuffer(W.vb);
+	DestroyBuffer(W.ib);
+	DestroyBuffer(W.materials);
+	for (auto& t : W.textures) DestroyTexture(t);
+	W.textures.clear();
+	W.clusters.clear(); W.lods.clear(); W.mats.clear(); W.lights.clear();
+	W.active = false;
+	W.name.clear();
+}
+
+void World_Shutdown()
+{
+	World_Unload();
+	for (auto*& p : W.gbPSO) { if (p) p->Release(); p = nullptr; }
+	for (auto*& p : W.shPSO) { if (p) p->Release(); p = nullptr; }
+	if (W.fxPSO) { W.fxPSO->Release(); W.fxPSO = nullptr; }
+	Shader* s[] = { &W.vs, &W.ps, &W.shadowPS, &W.fxPS };
+	for (auto* x : s) { if (x->blob) x->blob->Release(); *x = Shader(); }
+	W.pipelines = false;
+}
+
+static FILE* OpenWorldFile(const char* mapName, std::string& path)
+{
+	const char* base = ri.Cvar_VariableString("fs_basepath");
+	const char* home = ri.Cvar_VariableString("fs_homepath");
+	const char* game = ri.Cvar_VariableString("fs_game");
+	const char* dirs[] = { game, "base" };
+	const char* roots[] = { home, base };
+	const char* extra = ri.Cvar_VariableString("kt_worldPath");
+	if (extra && extra[0]) {
+		path = std::string(extra) + "/" + mapName + ".kworld";
+		if (FILE* f = fopen(path.c_str(), "rb")) return f;
+	}
+	for (const char* root : roots) {
+		if (!root || !*root) continue;
+		for (const char* d : dirs) {
+			if (!d || !*d) continue;
+			path = std::string(root) + "/" + d + "/maps/" + mapName + ".kworld";
+			FILE* f = fopen(path.c_str(), "rb");
+			if (f) return f;
+		}
+	}
+	return nullptr;
+}
+
+static void ParseEnv(const std::string& text, WorldEnv& e, int& envTex)
+{
+	size_t p = 0;
+	while (p < text.size()) {
+		size_t nl = text.find('\n', p);
+		if (nl == std::string::npos) nl = text.size();
+		std::string line = text.substr(p, nl - p);
+		p = nl + 1;
+		char key[64]; float a = 0, b = 0, c = 0;
+		int n = sscanf(line.c_str(), "%63s %f %f %f", key, &a, &b, &c);
+		if (n < 2) continue;
+		std::string k = key;
+		if (k == "sunDir" && n >= 4) { e.sunDir[0] = a; e.sunDir[1] = b; e.sunDir[2] = c; }
+		else if (k == "sunColor" && n >= 4) { e.sunColor[0] = a; e.sunColor[1] = b; e.sunColor[2] = c; }
+		else if (k == "sunIntensity") e.sunIntensity = a;
+		else if (k == "sunAngle") e.sunAngle = a;
+		else if (k == "skyIntensity") e.skyIntensity = a;
+		else if (k == "haze") e.haze = a;
+		else if (k == "ambient") e.ambient = a;
+		else if (k == "fogDensity") e.fogDensity = a;
+		else if (k == "fogFalloff") e.fogFalloff = a;
+		else if (k == "fogHeight") e.fogHeight = a;
+		else if (k == "fogStart") e.fogStart = a;
+		else if (k == "fogMax") e.fogMax = a;
+		else if (k == "fogColor" && n >= 4) { e.fogColor[0] = a; e.fogColor[1] = b; e.fogColor[2] = c; }
+		else if (k == "exposureEV") e.exposureEV = a;
+		else if (k == "envTex") envTex = (int)a;
+		else if (k == "envStrength") { e.envStrength = a; e.envLight = a; }
+		else if (k == "envLight") e.envLight = a;
+		else if (k.size() == 3 && k[0] == 's' && k[1] == 'h' && k[2] >= '0' && k[2] <= '8' && n >= 4) {
+			int i = k[2] - '0';
+			e.sh[i][0] = a; e.sh[i][1] = b; e.sh[i][2] = c;
+			e.hasSH = true;
+		}
+	}
+}
+
+bool World_Load(const char* mapName)
+{
+	World_Unload();
+	std::string path;
+	FILE* f = OpenWorldFile(mapName, path);
+	if (!f) return false;
+	if (!CreateWorldPipelines()) { fclose(f); Log("^1KatarnEngine: world shaders failed\n"); return false; }
+	int t0 = ri.Milliseconds();
+	KwHeader h;
+	if (fread(&h, sizeof(h), 1, f) != 1 || memcmp(h.magic, KW_MAGIC, 8) || h.version != KW_VERSION) {
+		Log("^1KatarnEngine: %s is not a version %d .kworld - cook it again with tools\\katarn_cook\n", path.c_str(), KW_VERSION);
+		fclose(f);
+		return false;
+	}
+	std::vector<KwSection> secs(h.numSections);
+	fread(secs.data(), sizeof(KwSection), h.numSections, f);
+	auto find = [&](uint32_t type) -> const KwSection* { for (auto& s : secs) if (s.type == type) return &s; return nullptr; };
+	auto readVec = [&](uint32_t type, auto& vec) {
+		const KwSection* s = find(type);
+		using T = typename std::remove_reference<decltype(vec)>::type::value_type;
+		vec.clear();
+		if (!s) return;
+		vec.resize(s->size / sizeof(T));
+		_fseeki64(f, (long long)s->offset, SEEK_SET);
+		fread(vec.data(), sizeof(T), vec.size(), f);
+	};
+	readVec(KW_CLUS, W.clusters);
+	readVec(KW_LODS, W.lods);
+	readVec(KW_MATL, W.mats);
+	readVec(KW_LITE, W.lights);
+	std::vector<uint8_t> splatRaw;
+	readVec(KW_SPLT, splatRaw);
+	std::vector<KwTexture> texs;
+	readVec(KW_TEXT, texs);
+	W.env = WorldEnv();
+	int envTex = -1;
+	if (const KwSection* s = find(KW_ENVT)) {
+		std::string text(s->size, '\0');
+		_fseeki64(f, (long long)s->offset, SEEK_SET);
+		fread(&text[0], 1, s->size, f);
+		ParseEnv(text, W.env, envTex);
+	}
+	{
+		// maps/<map>.kenv next to the .kworld: the same "key value" lines, read after the cooked ones, so sun, fog,
+		// exposure and sky can be tuned without cooking the world again
+		std::string ep = path.substr(0, path.size() - 7) + ".kenv";
+		if (FILE* ef = fopen(ep.c_str(), "rb")) {
+			std::string t;
+			char buf[4096]; size_t n;
+			while ((n = fread(buf, 1, sizeof(buf), ef)) > 0) t.append(buf, n);
+			fclose(ef);
+			int dummy = envTex;
+			ParseEnv(t, W.env, dummy);
+			ri.Printf(PRINT_ALL, "KatarnEngine: environment overrides from %s\n", ep.c_str());
+		}
+	}
+	memcpy(W.bmin, h.boundsMin, 12);
+	memcpy(W.bmax, h.boundsMax, 12);
+
+	auto uploadSection = [&](uint32_t type, Buffer& buf, const char* name) -> bool {
+		const KwSection* s = find(type);
+		if (!s || !s->size) return false;
+		if (!CreateBuffer(buf, s->size, false, name)) return false;
+		std::vector<uint8_t> chunk;
+		const uint64_t CH = 64ull << 20;
+		for (uint64_t off = 0; off < s->size; off += CH) {
+			uint64_t n = std::min<uint64_t>(CH, s->size - off);
+			chunk.resize(n);
+			_fseeki64(f, (long long)(s->offset + off), SEEK_SET);
+			fread(chunk.data(), 1, n, f);
+			UploadBuffer(buf, off, chunk.data(), n);
+			FlushUploads();
+		}
+		return true;
+	};
+	bool ok = uploadSection(KW_VERT, W.vb, "world vertices") && uploadSection(KW_INDX, W.ib, "world indices");
+	if (!ok) { Log("^1KatarnEngine: %s: geometry upload failed\n", path.c_str()); fclose(f); World_Unload(); return false; }
+
+	const KwSection* tdat = find(KW_TDAT);
+	W.textures.resize(texs.size());
+	uint64_t pending = 0, texBytes = 0;
+	std::vector<uint8_t> data;
+	for (size_t i = 0; i < texs.size() && tdat; i++) {
+		const KwTexture& k = texs[i];
+		Texture& t = W.textures[i];
+		DXGI_FORMAT fmt = (DXGI_FORMAT)k.format;
+		if (!CreateTexture(t, k.width, k.height, k.mips, fmt, k.srgb ? TEX_SRGB_VIEW : 0, 1, nullptr, "world texture")) continue;
+		data.resize(k.size);
+		_fseeki64(f, (long long)(tdat->offset + k.offset), SEEK_SET);
+		fread(data.data(), 1, k.size, f);
+		bool bc = fmt != DXGI_FORMAT_R8G8B8A8_UNORM;
+		uint32_t bpb = FormatBytes(fmt);
+		size_t off = 0;
+		for (uint32_t m = 0; m < k.mips; m++) {
+			uint32_t w = Q_max(1u, k.width >> m), hh = Q_max(1u, k.height >> m);
+			uint32_t rowBytes = bc ? ((w + 3) / 4) * bpb : w * 4;
+			uint32_t rows = bc ? (hh + 3) / 4 : hh;
+			if (off + (size_t)rowBytes * rows > data.size()) break;
+			UploadTexture(t, m, 0, data.data() + off, rowBytes);
+			off += (size_t)rowBytes * rows;
+		}
+		pending += k.size;
+		texBytes += k.size;
+		if (pending > (192ull << 20)) { FlushUploads(); pending = 0; }
+	}
+	FlushUploads();
+	fclose(f);
+	if (envTex >= 0 && envTex < (int)W.textures.size() && W.textures[envTex].res) W.env.envSrv = W.textures[envTex].srvSrgb;
+
+	std::vector<KwMaterial> gm = W.mats;
+	auto view = [&](int32_t ti, bool srgb) -> int32_t {
+		if (ti < 0 || ti >= (int)W.textures.size() || !W.textures[ti].res) return 0;
+		return (int32_t)(srgb ? W.textures[ti].srvSrgb : W.textures[ti].srv);
+	};
+	for (auto& m : gm) {
+		m.albedoTex = view(m.albedoTex, true);
+		m.normalTex = view(m.normalTex, false);
+		m.ormTex = view(m.ormTex, false);
+		m.emissiveTex = view(m.emissiveTex, true);
+	}
+	if (gm.empty()) { KwMaterial d = {}; d.baseColor[0] = d.baseColor[1] = d.baseColor[2] = d.baseColor[3] = 0.8f; d.roughness = 0.6f; gm.push_back(d); }
+	// splat (terrain) records go after the materials in the same buffer; their texture indices become views too
+	std::vector<uint8_t> splat = splatRaw;
+	const uint32_t splatBase = (uint32_t)(gm.size() * sizeof(KwMaterial));
+	for (size_t o = 0; o + sizeof(KwSplatHeader) <= splat.size(); ) {
+		KwSplatHeader* sh = (KwSplatHeader*)&splat[o];
+		sh->tintTex = view(sh->tintTex, false);
+		for (uint32_t i = 0; i < sh->numLayers && o + sizeof(KwSplatHeader) + (i + 1) * sizeof(KwSplatLayer) <= splat.size(); i++) {
+			uint8_t* lp = &splat[o + sizeof(KwSplatHeader) + i * sizeof(KwSplatLayer)];
+			if (sh->kind == 1) { KwFlowLayer* F = (KwFlowLayer*)lp; F->tex = view(F->tex, false); continue; }
+			KwSplatLayer* L = (KwSplatLayer*)lp;
+			L->albedoTex = view(L->albedoTex, true);
+			L->nohTex = view(L->nohTex, false);
+			L->maskTex = view(L->maskTex, false);
+		}
+		o += sizeof(KwSplatHeader) + sh->numLayers * sizeof(KwSplatLayer);
+	}
+	for (size_t i = 0; i < gm.size(); i++)
+		if (W.mats[i].flags & (KWM_SPLAT | KWM_FLOW)) gm[i].albedoTex = (int32_t)(splatBase + (uint32_t)W.mats[i].albedoTex);
+	size_t matBytes = gm.size() * sizeof(KwMaterial) + splat.size();
+	CreateBuffer(W.materials, (matBytes + 15) & ~(size_t)15, false, "world materials");
+	UploadBuffer(W.materials, 0, gm.data(), gm.size() * sizeof(KwMaterial));
+	if (!splat.empty()) UploadBuffer(W.materials, splatBase, splat.data(), splat.size());
+	FlushUploads();
+
+	W.hasFX = false;
+	for (auto& c : W.clusters) if (c.cls == KWC_FX) W.hasFX = true;
+	W.active = true;
+	W.name = mapName;
+	uint64_t tris = 0;
+	for (auto& c : W.clusters) if (c.numLods) tris += W.lods[c.firstLod].indexCount / 3;
+	Log("KatarnEngine: HD world %s - %u clusters, %.2fM triangles (LOD0), %.0f MB geometry, %u materials, %u textures (%llu MB), %u lights, sky %s, %d ms\n",
+		mapName, (unsigned)W.clusters.size(), tris / 1e6, (W.vb.size + W.ib.size) / 1048576.0, (unsigned)W.mats.size(),
+		(unsigned)W.textures.size(), (unsigned long long)(texBytes >> 20), (unsigned)W.lights.size(), W.env.envSrv ? "texture" : "atmosphere",
+		ri.Milliseconds() - t0);
+	return true;
+}
+
+// ------------------------------------------------------------------------------------------------ culling + drawing
+struct Frustum { float p[6][4]; int n; };
+static void FrustumFromMatrix(const float* m, Frustum& fr, bool ortho)
+{
+	auto row = [&](int r, float* o) { o[0] = m[r]; o[1] = m[4 + r]; o[2] = m[8 + r]; o[3] = m[12 + r]; };
+	float r0[4], r1[4], r2[4], r3[4];
+	row(0, r0); row(1, r1); row(2, r2); row(3, r3);
+	int n = 0;
+	for (int i = 0; i < 4; i++) fr.p[n][i] = r3[i] + r0[i]; n++;
+	for (int i = 0; i < 4; i++) fr.p[n][i] = r3[i] - r0[i]; n++;
+	for (int i = 0; i < 4; i++) fr.p[n][i] = r3[i] + r1[i]; n++;
+	for (int i = 0; i < 4; i++) fr.p[n][i] = r3[i] - r1[i]; n++;
+	if (ortho) {
+		for (int i = 0; i < 4; i++) fr.p[n][i] = r2[i]; n++;
+		for (int i = 0; i < 4; i++) fr.p[n][i] = r3[i] - r2[i]; n++;
+	}
+	else { for (int i = 0; i < 4; i++) fr.p[n][i] = r3[i] - r2[i]; n++; }
+	fr.n = n;
+}
+static bool BoxVisible(const Frustum& fr, const float* mn, const float* mx)
+{
+	for (int i = 0; i < fr.n; i++) {
+		const float* p = fr.p[i];
+		float x = p[0] >= 0 ? mx[0] : mn[0], y = p[1] >= 0 ? mx[1] : mn[1], z = p[2] >= 0 ? mx[2] : mn[2];
+		if (p[0] * x + p[1] * y + p[2] * z + p[3] < 0) return false;
+	}
+	return true;
+}
+static float BoxDistance(const float* p, const float* mn, const float* mx)
+{
+	float d2 = 0;
+	for (int i = 0; i < 3; i++) { float d = p[i] < mn[i] ? mn[i] - p[i] : p[i] > mx[i] ? p[i] - mx[i] : 0; d2 += d * d; }
+	return sqrtf(d2);
+}
+
+static void BindGeometry(ID3D12GraphicsCommandList* cl)
+{
+	Transition(cl, W.vb, D3D12_RESOURCE_STATE_VERTEX_AND_CONSTANT_BUFFER | D3D12_RESOURCE_STATE_INDEX_BUFFER | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+	Transition(cl, W.ib, D3D12_RESOURCE_STATE_VERTEX_AND_CONSTANT_BUFFER | D3D12_RESOURCE_STATE_INDEX_BUFFER | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+	Transition(cl, W.materials, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+	D3D12_VERTEX_BUFFER_VIEW vbv = { W.vb.va, (UINT)Q_min((uint64_t)0xffffffffu, W.vb.size), sizeof(KwVertex) };
+	D3D12_INDEX_BUFFER_VIEW ibv = { W.ib.va, (UINT)Q_min((uint64_t)0xffffffffu, W.ib.size), DXGI_FORMAT_R32_UINT };
+	cl->IASetVertexBuffers(0, 1, &vbv);
+	cl->IASetIndexBuffer(&ibv);
+	cl->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+}
+
+void World_DrawGBuffer(ID3D12GraphicsCommandList* cl, const WorldView& v)
+{
+	if (!W.active || !W.pipelines) return;
+	Frustum fr;
+	FrustumFromMatrix(v.viewProj, fr, false);
+	BindGeometry(cl);
+	float allowed = Q_max(0.1f, kt_lodError ? kt_lodError->value : 1.0f) * Q_max(0.1f, v.lodError);
+	int lock = kt_lodLock ? kt_lodLock->integer : -1;
+	ID3D12PipelineState* last = nullptr;
+	W.drawnTris = 0; W.drawnClusters = 0;
+	for (const KwCluster& c : W.clusters) {
+		if (!c.numLods || c.cls == KWC_FX || !BoxVisible(fr, c.boundsMin, c.boundsMax)) continue;
+		float dist = Q_max(1.0f, BoxDistance(v.cam, c.boundsMin, c.boundsMax));
+		uint32_t l = 0;
+		if (lock >= 0) l = Q_min((uint32_t)lock, c.numLods - 1);
+		else while (l + 1 < c.numLods && W.lods[c.firstLod + l + 1].error * v.pixelScale / dist <= allowed) l++;
+		const KwLod& lod = W.lods[c.firstLod + l];
+		ID3D12PipelineState* p = W.gbPSO[c.cls < 3 ? c.cls : 0];
+		if (p != last) {
+			cl->SetPipelineState(p); last = p;
+			uint32_t k[4] = { W.materials.srv, 0, 0, 0 };
+			cl->SetGraphicsRoot32BitConstants(RP_CONSTANTS, 4, k, 0);
+		}
+		cl->DrawIndexedInstanced(lod.indexCount, 1, lod.firstIndex, (INT)c.baseVertex, 0);
+		W.drawnTris += lod.indexCount / 3;
+		W.drawnClusters++;
+	}
+}
+
+// water / flowing water: forward into the HDR target (bound by the caller), after lighting
+void World_DrawFX(ID3D12GraphicsCommandList* cl, const WorldView& v)
+{
+	if (!W.active || !W.pipelines || !W.fxPSO || !W.hasFX) return;
+	Frustum fr;
+	FrustumFromMatrix(v.viewProj, fr, false);
+	BindGeometry(cl);
+	cl->SetPipelineState(W.fxPSO);
+	uint32_t k[4] = { W.materials.srv, 0, 0, 0 };
+	cl->SetGraphicsRoot32BitConstants(RP_CONSTANTS, 4, k, 0);
+	for (const KwCluster& c : W.clusters) {
+		if (!c.numLods || c.cls != KWC_FX || !BoxVisible(fr, c.boundsMin, c.boundsMax)) continue;
+		const KwLod& lod = W.lods[c.firstLod];
+		cl->DrawIndexedInstanced(lod.indexCount, 1, lod.firstIndex, (INT)c.baseVertex, 0);
+	}
+}
+
+void World_DrawShadow(ID3D12GraphicsCommandList* cl, int cascade, const float* vp, float texelWorld)
+{
+	if (!W.active || !W.pipelines) return;
+	Frustum fr;
+	FrustumFromMatrix(vp, fr, true);
+	BindGeometry(cl);
+	ID3D12PipelineState* last = nullptr;
+	for (const KwCluster& c : W.clusters) {
+		if (!c.numLods || (c.flags & 1) || c.cls == KWC_FX || !BoxVisible(fr, c.boundsMin, c.boundsMax)) continue;
+		uint32_t l = 0;
+		while (l + 1 < c.numLods && W.lods[c.firstLod + l + 1].error <= texelWorld * 1.5f) l++;
+		const KwLod& lod = W.lods[c.firstLod + l];
+		ID3D12PipelineState* p = W.shPSO[c.cls == KWC_MASKED ? 1 : 0];
+		if (p != last) {
+			cl->SetPipelineState(p); last = p;
+			uint32_t k[4] = { W.materials.srv, (uint32_t)cascade, 1, 0 };
+			cl->SetGraphicsRoot32BitConstants(RP_CONSTANTS, 4, k, 0);
+		}
+		cl->DrawIndexedInstanced(lod.indexCount, 1, lod.firstIndex, (INT)c.baseVertex, 0);
+	}
+}
+
+void World_AppendLights(std::vector<GpuLight>& out, const float* cam)
+{
+	if (!W.active || W.lights.empty()) return;
+	std::vector<std::pair<float, uint32_t>> order;
+	order.reserve(W.lights.size());
+	for (uint32_t i = 0; i < W.lights.size(); i++) {
+		const KwLight& l = W.lights[i];
+		float d[3] = { l.pos[0] - cam[0], l.pos[1] - cam[1], l.pos[2] - cam[2] };
+		order.push_back({ sqrtf(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]) - l.radius, i });
+	}
+	std::sort(order.begin(), order.end());
+	for (size_t k = 0; k < order.size() && k < 256; k++) {
+		const KwLight& l = W.lights[order[k].second];
+		GpuLight g = {};
+		memcpy(g.pos, l.pos, 12); g.radius = l.radius;
+		memcpy(g.color, l.color, 12); g.type = (float)l.type;
+		memcpy(g.dir, l.dir, 12); g.spotCos = l.spotCos;
+		g.spotInner = l.spotInnerCos; g.invSquare = l.invSquare;
+		out.push_back(g);
+	}
+}
+
+void World_Stats(uint32_t& clusters, uint64_t& tris) { clusters = W.drawnClusters; tris = W.drawnTris; }
+
+} // namespace kt
diff --git a/code/rd-katarn/katarn/kt_world.h b/code/rd-katarn/katarn/kt_world.h
new file mode 100644
index 00000000..625e383b
--- /dev/null
+++ b/code/rd-katarn/katarn/kt_world.h
@@ -0,0 +1,52 @@
+// KatarnEngine - HD worlds (.kworld)
+#pragma once
+#include "kt_device.h"
+
+namespace kt {
+
+struct GpuLight {           // matches lighting.hlsl Light (64 bytes)
+	float pos[3]; float radius;
+	float color[3]; float type;          // 0 point, 1 spot
+	float dir[3]; float spotCos;
+	float spotInner; float invSquare; float pad[2];
+};
+
+struct WorldEnv {
+	float sunDir[3] = { 0.4f, 0.3f, 0.86f };   // towards the sun
+	float sunColor[3] = { 1.0f, 0.95f, 0.88f };
+	float sunIntensity = 6.0f;
+	float sunAngle = 0.0093f;
+	float skyIntensity = 1.0f;
+	float haze = 0.4f;
+	float ambient = 1.0f;
+	float fogDensity = 0.00002f, fogFalloff = 0.0004f, fogHeight = 0.0f, fogStart = 600.0f;
+	float fogColor[3] = { 1, 1, 1 };
+	float fogMax = 0.85f;
+	float exposureEV = 0.0f;
+	uint32_t envSrv = 0;           // sky texture (equirectangular, sRGB view), 0 = Katarn's atmosphere
+	float envStrength = 1.0f;      // sky as seen by the camera
+	float envLight = 1.0f;         // sky as light (reflections)
+	bool hasSH = false;
+	float sh[9][3] = {};           // diffuse sky radiance (SH, cosine-convolved, / pi)
+};
+
+struct WorldView {
+	const float* viewProj;
+	float cam[3];
+	float pixelScale;              // pixels per unit at distance 1 (viewport height / 2 * cot(fovY / 2))
+	float lodError;                // allowed screen-space error, pixels
+};
+
+bool World_Load(const char* mapName);
+void World_Unload();
+bool World_Active();
+const WorldEnv& World_Env();
+void World_AppendLights(std::vector<GpuLight>& out, const float* camPos);
+// GBuffer: targets and view constants already bound
+void World_DrawGBuffer(ID3D12GraphicsCommandList* cl, const WorldView& v);
+void World_DrawFX(ID3D12GraphicsCommandList* cl, const WorldView& v);   // HDR target bound, depth readable
+void World_DrawShadow(ID3D12GraphicsCommandList* cl, int cascade, const float* cascadeViewProj, float texelWorld);
+void World_Shutdown();
+void World_Stats(uint32_t& clusters, uint64_t& tris);
+
+} // namespace kt
diff --git a/code/rd-katarn/katarn/kworld_format.h b/code/rd-katarn/katarn/kworld_format.h
new file mode 100644
index 00000000..5313fd9c
--- /dev/null
+++ b/code/rd-katarn/katarn/kworld_format.h
@@ -0,0 +1,125 @@
+// KatarnEngine .kworld - cooked HD world (shared by the renderer and tools/katarn_cook)
+//
+// File: KwHeader, KwSection table, then the sections (256-byte aligned).
+// The world is baked into world-space clusters (one spatial cell x one material class each). Every cluster has a
+// LOD chain over the same vertices; the renderer picks a LOD per cluster from its screen-space error. Each vertex
+// carries its material index, so a cluster is drawn with one call whatever materials it holds (bindless).
+// Coordinates are Quake units, Z up.
+#pragma once
+#include <stdint.h>
+
+#define KW_MAGIC "KWORLD02"
+#define KW_VERSION 2
+
+enum KwSectionType : uint32_t {
+	KW_VERT = 0x54524556,   // 'VERT' KwVertex[]
+	KW_INDX = 0x58444E49,   // 'INDX' uint32_t[] (relative to the cluster's baseVertex)
+	KW_CLUS = 0x53554C43,   // 'CLUS' KwCluster[]
+	KW_LODS = 0x53444F4C,   // 'LODS' KwLod[]
+	KW_MATL = 0x4C54414D,   // 'MATL' KwMaterial[]
+	KW_TEXT = 0x54584554,   // 'TEXT' KwTexture[]
+	KW_TDAT = 0x54414454,   // 'TDAT' texture mip data (offsets in KwTexture are relative to this section)
+	KW_LITE = 0x4554494C,   // 'LITE' KwLight[]
+	KW_ENVT = 0x54564E45,   // 'ENVT' environment, text: "key value value ..." per line
+	KW_SPLT = 0x544C5053,   // 'SPLT' splat (terrain) materials: KwSplatHeader + KwSplatLayer[] records
+};
+
+#pragma pack(push, 4)
+struct KwHeader {
+	char magic[8];
+	uint32_t version;
+	uint32_t numSections;
+	float boundsMin[3], boundsMax[3];
+};
+struct KwSection {
+	uint32_t type;
+	uint32_t pad;
+	uint64_t offset;
+	uint64_t size;
+};
+struct KwVertex {               // 32 bytes
+	float pos[3];
+	int16_t normal[2];          // octahedral, snorm
+	int16_t tangent[2];         // octahedral, snorm
+	float uv[2];
+	uint16_t material;
+	int16_t tangentSign;        // +1 / -1 (bitangent = cross(n, t) * sign)
+};
+enum KwClusterClass : uint32_t { KWC_OPAQUE = 0, KWC_TWOSIDED = 1, KWC_MASKED = 2, KWC_FX = 3 };   // FX: water / flowing water, drawn forward after lighting
+struct KwCluster {
+	float boundsMin[3], boundsMax[3];
+	uint32_t baseVertex, numVertices;
+	uint32_t firstLod, numLods;
+	uint32_t cls;               // KwClusterClass
+	uint32_t flags;             // 1 = no shadow
+};
+struct KwLod {
+	uint32_t firstIndex, indexCount;
+	float error;                // world units
+	uint32_t pad;
+};
+enum KwMaterialFlags : uint32_t { KWM_MASK = 1, KWM_TWOSIDED = 2, KWM_ORM_AO = 4, KWM_BLEND = 8, KWM_SPLAT = 16, KWM_WATER = 32, KWM_FLOW = 64, KWM_FOLIAGE = 128 };
+// KWM_FOLIAGE: leaves / grass (a Translucent BSDF in Blender): light through the leaves from behind, no collision.
+// KWM_WATER: baseColor = water colour, emissive = absorption colour, roughness, normalScale = wave strength.
+// KWM_FLOW: flowing water sheet (waterfalls), albedoTex = byte offset of a flow record (header kind 1) in SPLT.
+// KWM_SPLAT: a terrain material evaluated in the shader from world position (layers of tiled textures blended by
+// masks); albedoTex is then the byte offset of its KwSplatHeader in the SPLT section.
+struct KwMaterial {             // 64 bytes, same layout the shader reads (texture fields are texture indices, -1 = none)
+	float baseColor[4];
+	float roughness, metallic, normalScale, alphaCutoff;
+	int32_t albedoTex, normalTex, ormTex, emissiveTex;
+	float emissive[3];
+	uint32_t flags;
+};
+struct KwTexture {
+	uint64_t offset, size;      // in TDAT
+	uint32_t width, height, mips;
+	uint32_t format;            // DXGI_FORMAT (BC7_UNORM 98, BC5_UNORM 83, R8G8B8A8_UNORM 28)
+	uint32_t srgb;              // colour data: sample through the sRGB view
+	uint32_t pad;
+};
+struct KwLight {
+	float pos[3];
+	float radius;               // cut-off distance
+	float color[3];             // linear, already multiplied by intensity
+	uint32_t type;              // 0 point, 1 spot
+	float dir[3];
+	float spotCos, spotInnerCos;
+	float invSquare;            // >0: intensity / d^2 falloff (physical), 0: smooth window only
+	uint32_t pad[2];
+};
+// splat records. Coordinates are Blender metres (world position * invUnits). Masks / tint: u = x * xf[0] + xf[2],
+// v = y * xf[1] + xf[3], sampled at (u, 1 - v). Layers: u, v = x * scale, y * scale (repeat). Layer 0 is the base,
+// each further layer is blended over the result by its weight (mask channel, or the slope of the surface).
+struct KwSplatHeader {          // 64 bytes
+	uint32_t numLayers;
+	int32_t tintTex;            // -1 = none; albedo *= tint * tintMul
+	float tintMul;
+	float normalStrength;
+	float maskXf[4];
+	float tintXf[4];
+	float invUnits;
+	float roughness;            // < 0: per layer, 1 - albedo alpha (smoothness in alpha)
+	uint32_t kind;              // 0 splat, 1 flow (layers are KwFlowLayer)
+	uint32_t pad;
+};
+enum KwSplatLayerFlags : uint32_t { KWS_NORMAL_ONLY = 1 };
+struct KwSplatLayer {           // 32 bytes
+	int32_t albedoTex, nohTex;  // nohTex: normal in rg (y flipped: 1 - g)
+	float scale;
+	int32_t maskTex;            // -1 with maskChan 4: slope weight
+	uint32_t maskChan;          // 0..3 = r g b a, 4 = slope: 1 - saturate((n.z - slopeMin) / (slopeMax - slopeMin))
+	float slopeMin, slopeMax;
+	uint32_t flags;
+};
+// flow: alpha = (((layer0 op1 layer1) op2 layer2) ...) * tintMul, op 1 add / 2 multiply; layer = channel of a texture
+// sampled at uv * scale + speed * time (time in Blender frames, 24 per second). Colour = base colour + emission.
+struct KwFlowLayer {            // 32 bytes
+	int32_t tex;
+	uint32_t chan;
+	float scale[2];
+	float speed[2];
+	uint32_t op;
+	float pad;
+};
+#pragma pack(pop)
diff --git a/code/rd-katarn/katarn/shaders/common.hlsli b/code/rd-katarn/katarn/shaders/common.hlsli
new file mode 100644
index 00000000..ed5ff2be
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/common.hlsli
@@ -0,0 +1,117 @@
+// KatarnEngine - shared HLSL (shader model 5.1, bindless descriptor tables)
+#ifndef KT_COMMON
+#define KT_COMMON
+
+Texture2D Tex2D[] : register(t0, space1);
+TextureCube TexCube[] : register(t0, space2);
+Texture2DArray Tex2DArray[] : register(t0, space3);
+ByteAddressBuffer Buf[] : register(t0, space4);
+Texture3D Tex3D[] : register(t0, space5);
+RWTexture2D<float4> UavTex[] : register(u0, space1);
+RWByteAddressBuffer UavBuf[] : register(u0, space2);
+RWTexture2DArray<float4> UavTexArray[] : register(u0, space3);
+
+#ifdef KT_GLSLANG   // offline syntax check with glslang, which lacks arrays of byte-address buffers
+#define NonUniformResourceIndex(x) (x)
+ByteAddressBuffer BufOne : register(t1, space0);
+RWByteAddressBuffer UavBufOne : register(u1, space0);
+#define BUF(i) BufOne
+#define UAVBUF(i) UavBufOne
+#else
+#define BUF(i) Buf[NonUniformResourceIndex(i)]
+#define UAVBUF(i) UavBuf[NonUniformResourceIndex(i)]
+#endif
+
+SamplerState sWrap : register(s0);
+SamplerState sClamp : register(s1);
+SamplerState sWrapPoint : register(s2);
+SamplerState sClampPoint : register(s3);
+SamplerComparisonState sShadow : register(s4);
+SamplerState sClampAniso : register(s5);
+
+static const float PI = 3.14159265359;
+
+// per-view constants (root CBV b1) - must match kt::ViewConstants
+cbuffer View : register(b1)
+{
+	float4x4 viewProj;         // world -> clip (reversed-Z, infinite)
+	float4x4 invViewProj;
+	float4x4 worldToEye;       // GL eye space (-Z forward)
+	float4x4 prevViewProj;
+	float4 camPos;             // xyz, w = near plane
+	float4 viewport;           // x, y (top-left, pixels), w, h
+	float4 invTargetSize;      // 1/w, 1/h of the full-size scene targets, w,h
+	float4 projParams;         // sx, sy (1/tan half fov), near, time
+	float4 sunDir;             // towards the sun, w = sun angular radius
+	float4 sunColor;           // linear radiance (rgb), w = intensity scale
+	float4 skyParams;          // x turbidity / haze, y sky intensity, z ambient scale, w world mode (1 = HD world)
+	float4 fogParams;          // x density, y height falloff, z base height, w start distance
+	float4 fogColor;           // rgb inscatter colour, w max opacity
+	float4x4 cascadeViewProj[4];
+	float4 cascadeSplits;      // view depth of each cascade's far end
+	float4 shadowParams;       // x texel size, y bias, z normal bias, w enabled
+	uint4 indices0;            // x gbuffer0, y gbuffer1, z gbuffer2, w depth (SRV)
+	uint4 indices1;            // x shadow array, y ao, z sky LUT, w exposure buffer
+	uint4 indices2;            // x light buffer, y light count, z hdr srv, w frame
+	float4 postParams;         // x exposure compensation (EV), y bloom intensity, z manual exposure (0 = auto), w legacy glow boost
+	float4 ambientSH[9];       // sky irradiance SH (rgb)
+	float4 extraParams;        // x overbright scale (2^r_overBrightBits, applied when presenting), y 1 = AgX tone mapping, z 1 = keep the sky portal view
+	float4x4 viewProjNoJitter; // TAA: this frame without the jitter
+	uint4 probeParams;         // x reflection probe buffer, y probe count, z strength (asfloat)
+};
+float3 Sane(float3 c) { c = isnan(c) ? 0 : c; return clamp(c, 0, 32000.0); }   // NaN -> 0, overflow (inf) -> bright, never black
+float Overbright() { return max(extraParams.x, 1.0); }
+
+float3 SrgbToLinear(float3 c) { return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4); }
+float3 LinearToSrgb(float3 c) { c = max(c, 0); return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(c, 1.0 / 2.4) - 0.055; }
+float Luminance(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }
+
+float2 OctWrap(float2 v) { return (1.0 - abs(v.yx)) * (v.xy >= 0.0 ? 1.0 : -1.0); }
+float2 EncodeNormal(float3 n)
+{
+	n /= (abs(n.x) + abs(n.y) + abs(n.z));
+	n.xy = n.z >= 0.0 ? n.xy : OctWrap(n.xy);
+	return n.xy;
+}
+float3 DecodeNormal(float2 f)
+{
+	float3 n = float3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
+	float t = saturate(-n.z);
+	n.xy += n.xy >= 0.0 ? -t : t;
+	return normalize(n);
+}
+
+float3 WorldFromDepth(float2 uv, float depth)
+{
+	float4 clip = float4(uv * float2(2, -2) + float2(-1, 1), depth, 1);
+	float4 w = mul(invViewProj, clip);
+	return w.xyz / w.w;
+}
+float ViewDepth(float depth) { return projParams.z / max(depth, 1e-7); }   // reversed-Z infinite: near / depth
+
+float Exposure()
+{
+	return asfloat(BUF(indices1.w).Load(0));
+}
+
+float3 EvalSH(float3 n)
+{
+	float3 r = ambientSH[0].rgb * 0.282095;
+	r += ambientSH[1].rgb * 0.488603 * n.y + ambientSH[2].rgb * 0.488603 * n.z + ambientSH[3].rgb * 0.488603 * n.x;
+	r += ambientSH[4].rgb * 1.092548 * n.x * n.y + ambientSH[5].rgb * 1.092548 * n.y * n.z;
+	r += ambientSH[6].rgb * 0.315392 * (3.0 * n.z * n.z - 1.0);
+	r += ambientSH[7].rgb * 1.092548 * n.x * n.z + ambientSH[8].rgb * 0.546274 * (n.x * n.x - n.y * n.y);
+	return max(r, 0);
+}
+
+// fullscreen triangle
+struct FsOut { float4 pos : SV_Position; float2 uv : TEXCOORD0; };
+FsOut FullscreenVS(uint id : SV_VertexID)
+{
+	FsOut o;
+	o.uv = float2((id << 1) & 2, id & 2);
+	o.pos = float4(o.uv * float2(2, -2) + float2(-1, 1), 0, 1);
+	return o;
+}
+
+#endif
diff --git a/code/rd-katarn/katarn/shaders/gen.py b/code/rd-katarn/katarn/shaders/gen.py
new file mode 100644
index 00000000..65218504
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/gen.py
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+"""Embeds the HLSL sources into ../kt_shaders_gen.h (common.hlsli inlined). Run after editing a shader."""
+import os, re
+here = os.path.dirname(os.path.abspath(__file__))
+common = open(os.path.join(here, 'common.hlsli')).read()
+out = ['// generated by shaders/gen.py - do not edit', '#pragma once', '']
+for f in sorted(os.listdir(here)):
+    if not f.endswith('.hlsl'):
+        continue
+    src = open(os.path.join(here, f)).read().replace('#include "common.hlsli"', common)
+    name = 'kt_src_' + f[:-5]
+    # MSVC limits string literals to ~16K: split into chunks
+    chunks = [src[i:i + 12000] for i in range(0, len(src), 12000)]
+    out.append('static const char* const %s_parts[] = {' % name)
+    for c in chunks:
+        out.append('R"KTSRC(%s)KTSRC",' % c)
+    out.append('nullptr };')
+out.append('')
+open(os.path.join(here, '..', 'kt_shaders_gen.h'), 'w').write('\n'.join(out))
+print('wrote kt_shaders_gen.h')
diff --git a/code/rd-katarn/katarn/shaders/legacy.hlsl b/code/rd-katarn/katarn/shaders/legacy.hlsl
new file mode 100644
index 00000000..02e004f3
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/legacy.hlsl
@@ -0,0 +1,84 @@
+// KatarnEngine - legacy fixed-function content (menus, HUD, BSP surfaces, effects) translated from GL 1.x
+#include "common.hlsli"
+
+cbuffer Draw : register(b0)
+{
+	float4x4 mvp;
+	uint tex0;
+	uint tex1;
+	uint flags;
+	float alphaRef;
+	uint drawTarget;        // 0 screen (display-referred, as GL drew it), 1 HDR scene (linear radiance)
+	float glowBoost;
+	float drawScale;        // extra brightness in the HDR scene (saber glows)
+	uint drawPad1;
+	float4 drawExtra[2];
+};
+
+struct VsIn { float3 pos : POSITION; float2 uv0 : TEXCOORD0; float2 uv1 : TEXCOORD1; float4 color : COLOR; };
+struct VsOut { float4 pos : SV_Position; float2 uv0 : TEXCOORD0; float2 uv1 : TEXCOORD1; float4 color : COLOR; };
+
+VsOut VS(VsIn i)
+{
+	VsOut o;
+	o.pos = mul(mvp, float4(i.pos, 1));
+	o.uv0 = i.uv0;
+	o.uv1 = i.uv1;
+	o.color = i.color;
+	return o;
+}
+
+float4 SampleUnit(uint tex, float2 uv, bool clampMode, bool pointMode)
+{
+	if (pointMode) return clampMode ? Tex2D[NonUniformResourceIndex(tex)].Sample(sClampPoint, uv) : Tex2D[NonUniformResourceIndex(tex)].Sample(sWrapPoint, uv);
+	return clampMode ? Tex2D[NonUniformResourceIndex(tex)].Sample(sClampAniso, uv) : Tex2D[NonUniformResourceIndex(tex)].Sample(sWrap, uv);
+}
+
+struct PsOut { float4 c : SV_Target0; float4 glow : SV_Target1; };
+float4 Shade(VsOut i);
+PsOut PS(VsOut i)
+{
+	PsOut o;
+	o.c = Shade(i);
+	// glow stages also go to the glow target (blurred into the bloom); everything else only covers it
+	o.glow = (drawTarget == 1 && (flags & (1u << 11))) ? o.c : float4(0, 0, 0, o.c.a);
+	return o;
+}
+float4 Shade(VsOut i)
+{
+	float4 c = i.color;
+	if (drawTarget == 1) c.rgb = SrgbToLinear(c.rgb);
+	if (flags & 1) {
+		float4 t = SampleUnit(tex0, i.uv0, (flags & 4) != 0, (flags & 16) != 0);
+		uint env0 = (flags >> 12) & 3;
+		if (env0 == 2) c = t; else c *= t;
+	}
+	if (flags & 2) {
+		float4 t = SampleUnit(tex1, i.uv1, (flags & 8) != 0, (flags & 32) != 0);
+		uint env = (flags >> 6) & 3;
+		if (env == 0) c *= t;
+		else if (env == 1) { c.rgb += t.rgb; c.a *= t.a; }
+		else if (env == 2) c = t;
+		else c.rgb = lerp(c.rgb, t.rgb, t.a);
+	}
+	uint at = (flags >> 8) & 7;
+	if (at != 0) {
+		bool keep = true;
+		if (at == 1) keep = c.a > alphaRef;
+		else if (at == 2) keep = c.a < alphaRef;
+		else if (at == 3) keep = c.a >= alphaRef;
+		else if (at == 4) keep = c.a <= alphaRef;
+		else if (at == 5) keep = c.a == alphaRef;
+		else if (at == 6) keep = c.a != alphaRef;
+		else keep = false;
+		if (!keep) discard;
+	}
+	if (drawTarget == 1) {
+		// LDR content in an HDR scene: undo the camera exposure so it shows at its authored brightness
+		float s = (skyParams.w > 0.5 ? Overbright() : 1.0) / max(Exposure(), 1e-6);   // HD: legacy colours are scaled by identityLight
+		if ((flags & (1u << 11)) && skyParams.w > 0.5) s *= glowBoost;   // HD worlds only: old maps keep their authored glow
+		s *= drawScale > 0 ? drawScale : 1.0;
+		c.rgb = min(c.rgb * s, 1500.0);   // stacked additive sprites (saber glow) must not overflow the half-float scene
+	}
+	return c;
+}
diff --git a/code/rd-katarn/katarn/shaders/legacy_gbuffer.hlsl b/code/rd-katarn/katarn/shaders/legacy_gbuffer.hlsl
new file mode 100644
index 00000000..9a0ebca0
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/legacy_gbuffer.hlsl
@@ -0,0 +1,199 @@
+// KatarnEngine - legacy opaque surfaces (Ghoul2 characters, BSP world, MD3 models) written into the GBuffer, so they
+// get Katarn's sun, shadows, lights, sky ambient and AO like the HD world does.
+#include "common.hlsli"
+
+cbuffer DrawC : register(b0)
+{
+	uint cascadeIdx;
+	uint gmode;         // 0 gbuffer, 1 shadow
+};
+
+// per draw (b2, from the upload ring)
+cbuffer DrawG : register(b2)
+{
+	float4x4 gMvp;                      // the same matrix the GL translation uses, so EQUAL-depth extra stages match exactly
+	float4 objRow0;
+	float4 objRow1;
+	float4 objRow2;                     // object -> world
+	uint albedoTex;     // sRGB view
+	uint lightmapTex;   // sRGB view, 0 = none
+	uint gflags;        // 1 alpha test, 2 tint by vertex colour, 4 baked = lightmap, 8 baked = vertex colour
+	float alphaRef;
+	float roughness;
+	float metallic;
+	float bakedScale;
+	uint specTex;
+	float4 tint;        // constant tint (rgbGen const / entity)
+	uint normalTex;     // rend2-style normal map (tangent space, from the stage's normalMap), 0 = none
+	uint rmoTex;        // roughness / metal / occlusion map, 0 = none
+	uint rmoOrder;      // 0 rmo, 1 orm
+	float skinAmount;   // rend2 skin keyword (subsurface), 0 = none
+	float4 gridAmbient;  // gflags 16: light grid (old BSP maps), 0-255 scale
+	float4 gridDirected;
+	float4 gridDir;      // world space, towards the light
+	uint deluxeTex;      // q3map2 deluxemap of the lightmap (world-space light direction), 0 = none
+	float parallaxDepth; // parallax from the normal map's alpha (height), uv units, 0 = none
+	uint2 pad2;
+};
+
+// GGX highlight (times N.L) for one light direction
+float3 SpecGGX(float3 n, float3 V, float3 L, float rough, float3 f0)
+{
+	float nl = saturate(dot(n, L));
+	float3 H = normalize(L + V);
+	float r2 = max(rough * rough, 0.002);
+	float nh = saturate(dot(n, H)), nv = max(dot(n, V), 1e-3);
+	float D = r2 * r2 / (PI * pow(nh * nh * (r2 * r2 - 1) + 1, 2));
+	float k = r2 * 0.5;
+	float G = (nl / (nl * (1 - k) + k)) * (nv / (nv * (1 - k) + k));
+	float3 F = f0 + (1 - f0) * pow(1 - saturate(dot(H, V)), 5);
+	return D * G * F / max(4 * nl * nv, 1e-3) * nl;
+}
+
+struct VsIn { float3 pos : POSITION; float3 normal : NORMAL; float2 uv : TEXCOORD0; float2 lmuv : TEXCOORD1; float4 color : COLOR; };
+struct VsOut { float4 pos : SV_Position; float3 normal : NORMAL; float2 uv : TEXCOORD0; float2 lmuv : TEXCOORD1; float4 color : COLOR; float3 wpos : TEXCOORD2; };
+
+VsOut VS(VsIn i)
+{
+	float4 p = float4(i.pos, 1);
+	float3 wp = float3(dot(objRow0, p), dot(objRow1, p), dot(objRow2, p));
+	VsOut o;
+	o.pos = gmode == 1 ? mul(cascadeViewProj[cascadeIdx], float4(wp, 1)) : mul(gMvp, p);
+	o.normal = float3(dot(objRow0.xyz, i.normal), dot(objRow1.xyz, i.normal), dot(objRow2.xyz, i.normal));
+	o.uv = i.uv;
+	o.lmuv = i.lmuv;
+	o.color = i.color;
+	o.wpos = wp;
+	return o;
+}
+
+struct GBufferOut { float4 albedo : SV_Target0; float4 normal : SV_Target1; float4 emissive : SV_Target2; };
+
+GBufferOut PS(VsOut i, bool front : SV_IsFrontFace)
+{
+	float3 n = normalize(i.normal);
+	// Quake's front faces are clockwise (it culls GL_FRONT with the CCW default), so a "front" face here is the back
+	// of the surface: flip the normal towards the viewer only then
+	if (front) n = -n;
+	float3 n0 = n;
+	float3 V = normalize(camPos.xyz - i.wpos);
+	float2 uv = i.uv;
+	float2 uvdx = ddx(i.uv), uvdy = ddy(i.uv);
+	float3 T = 0, B = 0;
+	float invmax = 0;
+	if (normalTex) {
+		// no vertex tangents in the old formats: a cotangent frame from the screen-space derivatives
+		float3 dp1 = ddx(i.wpos), dp2 = ddy(i.wpos);
+		float3 dp2perp = cross(dp2, n), dp1perp = cross(n, dp1);
+		T = dp2perp * uvdx.x + dp1perp * uvdy.x;
+		B = dp2perp * uvdx.y + dp1perp * uvdy.y;
+		invmax = rsqrt(max(max(dot(T, T), dot(B, B)), 1e-20));
+		if (parallaxDepth > 0) {
+			// rend2 parallax: the normal map's alpha is the height (1 = top); march the view ray down through it
+			float3 Tn = T * invmax, Bn = B * invmax;
+			float3 vt = float3(dot(V, Tn), dot(V, Bn), dot(V, n));
+			if (vt.z > 0.05 && all(isfinite(vt))) {
+				float2 p = vt.xy / max(vt.z, 0.25) * parallaxDepth;
+				int steps = (int)lerp(16.0, 6.0, saturate(vt.z));
+				float stepD = 1.0 / steps;
+				float layer = 0, prevLayer = 0;
+				float depthHere = 1.0 - Tex2D[NonUniformResourceIndex(normalTex)].SampleGrad(sWrap, uv, uvdx, uvdy).a, prevDepth = depthHere;
+				[loop] for (int k = 0; k < 16 && k < steps && layer < depthHere; k++) {
+					prevLayer = layer; prevDepth = depthHere;
+					layer += stepD;
+					depthHere = 1.0 - Tex2D[NonUniformResourceIndex(normalTex)].SampleGrad(sWrap, i.uv - p * layer, uvdx, uvdy).a;
+				}
+				// linear refinement between the last two layers
+				float after = depthHere - layer, before = prevDepth - prevLayer;
+				float w = saturate(after / min(after - before, -1e-4));
+				uv = i.uv - p * lerp(layer, prevLayer, w);
+			}
+		}
+	}
+	float4 a = tint;
+	if (albedoTex) a *= Tex2D[NonUniformResourceIndex(albedoTex)].SampleGrad(sWrap, uv, uvdx, uvdy);
+	if (gflags & 2) a *= float4(SrgbToLinear(i.color.rgb), i.color.a);
+	if (gflags & 1) clip(a.a - alphaRef);
+	if (normalTex) {
+		float3 tn = Tex2D[NonUniformResourceIndex(normalTex)].SampleGrad(sWrap, uv, uvdx, uvdy).xyz * 2 - 1;
+		tn.z = sqrt(saturate(1 - dot(tn.xy, tn.xy)));
+		float3 nm = normalize(T * invmax * tn.x - B * invmax * tn.y + n * tn.z);   // uv v runs down: flip the bitangent
+		if (all(isfinite(nm))) n = nm;
+	}
+	float rough = roughness, metal = metallic, matAO = 1;
+	if (rmoTex) {
+		float3 r = Tex2D[NonUniformResourceIndex(rmoTex)].SampleGrad(sWrap, uv, uvdx, uvdy).rgb;
+		if (rmoOrder == 1) r = r.gbr;     // orm -> rmo
+		rough = r.x; metal = r.y; matAO = r.z;
+	}
+	if (specTex) {
+		// rend2 specularMap: rgb = specular colour, a = gloss
+		float4 sp = Tex2D[NonUniformResourceIndex(specTex)].SampleGrad(sWrap, uv, uvdx, uvdy);
+		rough = sp.a < 0.999 ? 1.0 - sp.a : saturate(1.0 - Luminance(sp.rgb) * 0.9);
+	}
+	// models without PBR maps are flagged (metal + 2) so the lighting keeps their reflections soft, like rend2
+	// (no specular / gloss data: a dull dielectric, not a coated one)
+	bool authored = rmoTex != 0 || specTex != 0;
+	float3 baked = 0;
+	bool hasBaked = false;
+	float3 bakedSpec = 0;
+	if ((gflags & 4) && lightmapTex) {
+		baked = Tex2D[NonUniformResourceIndex(lightmapTex)].Sample(sClamp, i.lmuv).rgb * bakedScale;
+		hasBaked = true;
+		if (deluxeTex) {
+			// deluxemap: the lightmap's light arrives from this direction - the normal map shades it, and it gets a
+			// highlight (rend2 deluxe mapping). A short vector = light from all around (less directional).
+			float3 L = Tex2D[NonUniformResourceIndex(deluxeTex)].Sample(sClamp, i.lmuv).xyz * 2 - 1;
+			float ll = length(L);
+			if (ll > 1e-3) {
+				L /= ll;
+				float dirAmt = saturate(ll * 1.2);
+				float n0l = max(saturate(dot(n0, L)), 0.2);
+				float shade = clamp(saturate(dot(n, L)) / n0l, 0.0, 2.0);
+				baked *= lerp(1.0, shade, dirAmt);
+				float3 f0s = lerp((rmoTex != 0 || specTex != 0) ? 0.04 : 0.012, a.rgb, saturate(metal));
+				bakedSpec = min(SpecGGX(n, V, L, clamp(rough, 0.08, 1.0), f0s) * baked * PI / n0l * dirAmt, 4.0);
+			}
+		}
+		else if (normalTex) baked *= saturate(dot(n, n0));   // no direction known: the bumps shade against the surface
+	}
+	else if (gflags & 8) { baked = SrgbToLinear(i.color.rgb) * bakedScale; hasBaked = true; }
+	float3 gridLit = 0;
+	if (gflags & 16) {
+		// old BSP map: lit from the light grid like rend2 - ambient + directed (per pixel, with the normal map),
+		// GGX highlight from the directed light; the lighting pass adds dynamic lights, AO and nothing else
+		float3 L = normalize(gridDir.xyz + float3(0, 0, 1e-4));
+		float nl = dot(n, L);
+		float ndl = skinAmount > 0 ? saturate((nl + 0.4) / 1.4) : saturate(nl);
+		float3 amb = gridAmbient.rgb / 255.0, dirc = gridDirected.rgb / 255.0;
+		float3 lightDisp = saturate(amb + dirc * ndl);
+		float3 lit = a.rgb * (1 - saturate(metal)) * SrgbToLinear(lightDisp);
+		float3 H = normalize(L + V);
+		float r2 = max(rough * rough, 0.002);
+		float nh = saturate(dot(n, H)), nv = max(dot(n, V), 1e-3);
+		float D = r2 * r2 / (PI * pow(nh * nh * (r2 * r2 - 1) + 1, 2));
+		float k = r2 * 0.5;
+		float G = (saturate(nl) / (saturate(nl) * (1 - k) + k)) * (nv / (nv * (1 - k) + k));
+		float3 f0 = lerp(authored ? 0.04 : 0.012, a.rgb, saturate(metal));
+		float3 F = f0 + (1 - f0) * pow(1 - saturate(dot(H, V)), 5);
+		float3 spec = D * G * F / max(4 * saturate(nl) * nv, 1e-3) * saturate(nl) * SrgbToLinear(saturate(dirc));
+		lit += spec + f0 * SrgbToLinear(saturate(amb)) * 0.5;   // a dim ambient reflection
+		gridLit = lit;
+		hasBaked = true;
+	}
+	GBufferOut o;
+	o.albedo = float4(a.rgb, matAO);
+	rough = clamp(rough, 0.045, 1.0);
+	o.normal = float4(EncodeNormal(n), hasBaked ? -rough : rough, saturate(metal) + (skinAmount > 0 ? 4.0 : (authored ? 0.0 : 2.0)));
+	o.emissive = float4((gflags & 16) ? gridLit : (hasBaked ? baked * a.rgb + bakedSpec : 0), 0);
+	return o;
+}
+
+void ShadowPS(VsOut i)
+{
+	if (gflags & 1) {
+		float al = tint.a;
+		if (albedoTex) al *= Tex2D[NonUniformResourceIndex(albedoTex)].Sample(sWrap, i.uv).a;
+		clip(al - alphaRef);
+	}
+}
diff --git a/code/rd-katarn/katarn/shaders/lighting.hlsl b/code/rd-katarn/katarn/shaders/lighting.hlsl
new file mode 100644
index 00000000..da7f5fbe
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/lighting.hlsl
@@ -0,0 +1,416 @@
+// KatarnEngine - deferred lighting: sun with cascaded shadows, local lights, sky ambient + reflections, height fog
+#include "common.hlsli"
+
+cbuffer Draw : register(b0)
+{
+	uint outUav;
+	uint shBuf;
+	uint lightBuf;
+	uint lightCount;
+	uint aoTex;
+	uint lflags;     // 1 = AO on, 2 = shadows on, 4 = volumetric sun
+	uint debugMode;
+	uint ssrSrv;     // last frame's lit scene (0 = no screen-space reflections)
+};
+
+struct Light { float3 pos; float radius; float3 color; float type; float3 dir; float spotCos; float spotInner; float invSquare; float2 lp; };
+Light LoadLight(uint i)
+{
+	float4 a = asfloat(BUF(lightBuf).Load4(i * 64)), c = asfloat(BUF(lightBuf).Load4(i * 64 + 16)), d = asfloat(BUF(lightBuf).Load4(i * 64 + 32)), e = asfloat(BUF(lightBuf).Load4(i * 64 + 48));
+	Light l;
+	l.pos = a.xyz; l.radius = a.w; l.color = c.rgb; l.type = c.w; l.dir = d.xyz; l.spotCos = d.w; l.spotInner = e.x; l.invSquare = e.y; l.lp = e.zw;
+	return l;
+}
+
+// the HD world's sky texture (Blender equirectangular), else Katarn's atmosphere LUT
+float3 SkyRadianceLod(float3 d, float lod)
+{
+	if (indices2.x) {
+		float2 uv = float2(0.5 - atan2(d.y, d.x) / (2 * PI), 0.5 - asin(clamp(d.z, -1, 1)) / PI);
+		return Tex2D[indices2.x].SampleLevel(sWrap, uv, lod).rgb * skyParams.y;
+	}
+	float phi = atan2(d.y, d.x);
+	float el = asin(clamp(d.z, -1, 1));
+	float2 uv = float2(phi / (2 * PI) + 0.5, 0.5 - el / PI);
+	return Tex2D[indices1.z].SampleLevel(sWrap, uv, 0).rgb;
+}
+
+float SkyMips()
+{
+	if (!indices2.x) return 1;
+	uint w, h, m;
+	Tex2D[indices2.x].GetDimensions(0, w, h, m);
+	return m;
+}
+
+float3 SkyRadiance(float3 d)
+{
+	if (indices2.x) return SkyRadianceLod(d, 0);
+	float phi = atan2(d.y, d.x);
+	float el = asin(clamp(d.z, -1, 1));
+	float2 uv = float2(phi / (2 * PI) + 0.5, 0.5 - el / PI);
+	return Tex2D[indices1.z].SampleLevel(sWrap, uv, 0).rgb;
+}
+
+float3 SkyAmbient(float3 n)
+{
+	if (indices2.y) return EvalSH(n);
+	float3 sh[9];
+	for (int k = 0; k < 9; k++) sh[k] = asfloat(BUF(shBuf).Load3(k * 16));
+	float3 r = sh[0] * 0.282095;
+	r += sh[1] * 0.488603 * n.y + sh[2] * 0.488603 * n.z + sh[3] * 0.488603 * n.x;
+	r += sh[4] * 1.092548 * n.x * n.y + sh[5] * 1.092548 * n.y * n.z;
+	r += sh[6] * 0.315392 * (3.0 * n.z * n.z - 1.0);
+	r += sh[7] * 1.092548 * n.x * n.z + sh[8] * 0.546274 * (n.x * n.x - n.y * n.y);
+	return max(r, 0);
+}
+
+// reflection probes (captured cubes): the nearest two, sphere-parallax corrected, blended by distance
+float3 ProbeOne(uint i, float3 P, float3 R, float rough, out float dist)
+{
+	float4 a = asfloat(BUF(probeParams.x).Load4(i * 32));
+	uint2 b = BUF(probeParams.x).Load2(i * 32 + 16);
+	float3 L = P - a.xyz;
+	dist = length(L);
+	float bq = dot(L, R), cq = dot(L, L) - a.w * a.w;
+	float3 dir = R;
+	if (cq < 0) dir = L + R * (-bq + sqrt(max(bq * bq - cq, 0)));
+	return TexCube[NonUniformResourceIndex(b.x)].SampleLevel(sClamp, float3(dir.x, dir.z, dir.y), rough * (b.y - 1)).rgb;
+}
+
+float3 SampleProbes(float3 P, float3 R, float rough, out float weight)
+{
+	weight = 0;
+	uint n = min(probeParams.y, 64u);
+	if (!n) return 0;
+	float d0 = 1e30, d1 = 1e30, r0 = 1;
+	uint i0 = 0, i1 = 0;
+	[loop] for (uint i = 0; i < n; i++) {
+		float4 a = asfloat(BUF(probeParams.x).Load4(i * 32));
+		float3 dd = a.xyz - P;
+		float q = dot(dd, dd);
+		if (q < d0) { d1 = d0; i1 = i0; d0 = q; i0 = i; r0 = a.w; }
+		else if (q < d1) { d1 = q; i1 = i; }
+	}
+	float e0, e1;
+	float3 c = ProbeOne(i0, P, R, rough, e0);
+	if (n > 1) {
+		float3 c1 = ProbeOne(i1, P, R, rough, e1);
+		c = lerp(c, c1, e0 / max(e0 + e1, 1e-3));
+	}
+	weight = saturate(2.0 - e0 / max(r0, 1.0));    // full inside the nearest probe's space, gone at twice its size
+	return min(c, 64.0);
+}
+
+float D_GGX(float NoH, float a) { float a2 = a * a; float f = (NoH * a2 - NoH) * NoH + 1.0; return a2 / (PI * f * f); }
+float V_Smith(float NoV, float NoL, float a)
+{
+	float a2 = a * a;
+	float gv = NoL * sqrt(NoV * NoV * (1.0 - a2) + a2);
+	float gl = NoV * sqrt(NoL * NoL * (1.0 - a2) + a2);
+	return 0.5 / max(gv + gl, 1e-5);
+}
+float3 F_Schlick(float3 f0, float VoH) { return f0 + (1.0 - f0) * pow(1.0 - VoH, 5.0); }
+float3 EnvBRDFApprox(float3 f0, float rough, float NoV)
+{
+	const float4 c0 = float4(-1, -0.0275, -0.572, 0.022);
+	const float4 c1 = float4(1, 0.0425, 1.04, -0.04);
+	float4 r = rough * c0 + c1;
+	float a004 = min(r.x * r.x, exp2(-9.28 * NoV)) * r.x + r.y;
+	float2 ab = float2(-1.04, 1.04) * a004 + r.zw;
+	return f0 * ab.x + ab.y;
+}
+
+float3 Brdf(float3 N, float3 V, float3 L, float3 diff, float3 f0, float rough)
+{
+	float3 H = normalize(V + L);
+	float NoL = saturate(dot(N, L)), NoV = max(dot(N, V), 1e-4), NoH = saturate(dot(N, H)), VoH = saturate(dot(V, H));
+	float a = rough * rough;
+	float3 spec = D_GGX(NoH, a) * V_Smith(NoV, NoL, a) * F_Schlick(f0, VoH);
+	return (diff / PI + spec) * NoL;
+}
+
+float Shadow(float3 P, float3 N, float viewZ)
+{
+	if (!(lflags & 2) || shadowParams.w == 0) return 1;
+	int c = 0;
+	[unroll] for (int i = 0; i < 4; i++) if (viewZ > cascadeSplits[i]) c = i + 1;
+	if (c >= 4) return 1;
+	float texel = shadowParams.x;
+	float3 Pn = P + N * shadowParams.z * (1 + c * 1.5);
+	float4 sc = mul(cascadeViewProj[c], float4(Pn, 1));
+	float2 suv = sc.xy * float2(0.5, -0.5) + 0.5;
+	float z = sc.z - shadowParams.y;
+	if (any(suv < 0) || any(suv > 1) || z > 1) return 1;
+	float s = 0;
+	[unroll] for (int y = -2; y <= 2; y++)
+		[unroll] for (int x = -2; x <= 2; x++)
+			s += Tex2DArray[indices1.x].SampleCmpLevelZero(sShadow, float3(suv + float2(x, y) * texel, c), z);
+	s /= 25.0;
+	float fade = saturate((cascadeSplits[3] - viewZ) / (cascadeSplits[3] * 0.1));
+	return lerp(1, s, c == 3 ? fade : 1);
+}
+
+// screen-space shadow: march from P towards the light through the depth buffer (contact shadows; shadows of
+// characters / props for lights that have no shadow map - sabers, dynamic lights)
+float ScreenShadow(float3 P, float3 N, float3 L, float dist, int steps, float thick, float jitter)
+{
+	float3 O = P + N * 1.0 + L * 1.0;
+	float stepLen = dist / steps;
+	float occ = 0;
+	[loop] for (int i = 0; i < steps; i++) {
+		float3 Q = O + L * stepLen * (i + jitter);
+		float4 cp = mul(viewProj, float4(Q, 1));
+		if (cp.w <= 0) break;
+		float2 suv = cp.xy / cp.w * float2(0.5, -0.5) + 0.5;
+		if (any(suv < 0) || any(suv > 1)) break;
+		float sd = Tex2D[indices0.w].Load(int3(viewport.xy + suv * viewport.zw, 0)).r;
+		if (sd <= 0) continue;
+		float dz = ViewDepth(cp.z / cp.w) - ViewDepth(sd);
+		if (dz > 0.4 && dz < thick) { occ = max(occ, saturate(1 - (float)i / steps) * 0.5 + 0.5); if (occ > 0.99) break; }
+	}
+	return 1 - occ;
+}
+
+// one shadow tap (volumetric fog marching)
+float ShadowFast(float3 P, float viewZ)
+{
+	int c = 0;
+	[unroll] for (int i = 0; i < 4; i++) if (viewZ > cascadeSplits[i]) c = i + 1;
+	if (c >= 4) return 1;
+	float4 sc = mul(cascadeViewProj[c], float4(P, 1));
+	float2 suv = sc.xy * float2(0.5, -0.5) + 0.5;
+	if (any(suv < 0) || any(suv > 1) || sc.z > 1) return 1;
+	return Tex2DArray[indices1.x].SampleCmpLevelZero(sShadow, float3(suv, c), sc.z - shadowParams.y * 2);
+}
+
+float3 ApplyFog(float3 col, float3 P, float3 V, float dist)
+{
+	if (fogParams.x <= 0) return col;
+	float rayLen = max(dist - fogParams.w, 0);
+	float dz = P.z - camPos.z;
+	float f = fogParams.y;
+	float camDens = fogParams.x * exp(-f * (camPos.z - fogParams.z));
+	float fz = f * dz;
+	float lineInt = abs(fz) > 1e-4 ? (1 - exp(-fz)) / fz : 1 - 0.5 * fz;
+	float amount = camDens * lineInt * rayLen;
+	float opacity = min(1 - exp(-amount), fogColor.w);
+	float3 hd = normalize(float3(-V.xy, 0.05));
+	// a blurred sky (top mips): the raw horizon row of a sky texture has sharp vertical detail, which the fog would
+	// smear into streaks running up the whole screen
+	float3 inscatter = (indices2.x ? SkyRadianceLod(hd, max(SkyMips() - 4, 0)) : SkyRadiance(hd)) * fogColor.rgb;
+	float sunVis = 1;
+	if ((lflags & 4) && (lflags & 2) && shadowParams.w > 0) {
+		// volumetric: how much of the view ray inside the shadow range sees the sun (shafts through the fog)
+		float maxD = min(dist, cascadeSplits[3]);
+		float jitter = frac(52.9829189 * frac(dot(P.xy * 0.37 + indices2.w * 0.618, float2(0.06711056, 0.00583715))));
+		float lit = 0;
+		const int STEPS = 16;
+		[loop] for (int k = 0; k < STEPS; k++) {
+			float t = (k + jitter) / STEPS;
+			t *= t;                                          // more samples near the camera
+			float3 Q = camPos.xyz - V * (maxD * t);
+			lit += ShadowFast(Q, maxD * t);
+		}
+		sunVis = lit / STEPS;
+		sunVis = lerp(1, sunVis, saturate(maxD / max(dist, 1)));
+	}
+	float phase = pow(saturate(dot(-V, sunDir.xyz)), 8) * 0.25 + 0.04;   // forward scattering + a little everywhere
+	inscatter += sunColor.rgb * sunColor.w * phase * fogColor.rgb * (sunVis * 1.6 - 0.15 * (1 - sunVis));
+	return lerp(col, max(inscatter, 0), opacity);
+}
+
+[numthreads(8, 8, 1)]
+void CS(uint3 id : SV_DispatchThreadID)
+{
+	if (id.x >= (uint)viewport.z || id.y >= (uint)viewport.w) return;
+	uint2 px = id.xy + (uint2)viewport.xy;
+	float2 uv = (id.xy + 0.5) / viewport.zw;
+	float depth = Tex2D[indices0.w].Load(int3(px, 0)).r;
+	float3 P = WorldFromDepth(uv, depth);
+	float3 toCam = camPos.xyz - P;
+	float dist = length(toCam);
+	float3 V = toCam / max(dist, 1e-4);
+	if (depth <= 0.0) {
+		float3 d = normalize(WorldFromDepth(uv, 1e-6) - camPos.xyz);
+		float3 c = SkyRadiance(d);
+		float cosSun = dot(d, sunDir.xyz);
+		float cosR = cos(sunDir.w);
+		if (cosSun > cosR && d.z > -0.02) c += sunColor.rgb * sunColor.w * 4000.0 * smoothstep(cosR, cosR + 0.00002, cosSun) * saturate(d.z * 20 + 0.4);
+		UavTex[outUav][px] = float4(c, 1);
+		return;
+	}
+	float4 g0 = Tex2D[indices0.x].Load(int3(px, 0));
+	float4 g1 = Tex2D[indices0.y].Load(int3(px, 0));
+	float3 g2 = Tex2D[indices0.z].Load(int3(px, 0)).rgb;
+	float3 N = DecodeNormal(g1.xy);
+	bool baked = g1.z < 0;
+	bool foliage = g1.w > 7.5;                   // HD world leaves / grass: light passes through
+	bool skin = !foliage && g1.w > 3.5;          // rend2 skin keyword: soft, subsurface-scattered diffuse
+	bool plainLegacy = !foliage && !skin && g1.w > 1.5;      // old model without PBR maps
+	float rough = abs(g1.z), metal = foliage ? g1.w - 8.0 : skin ? g1.w - 4.0 : plainLegacy ? g1.w - 2.0 : g1.w;
+	float3 albedo = g0.rgb;
+	float ao = g0.a;
+	if (lflags & 1) ao *= Tex2D[aoTex].Load(int3(px, 0)).r;
+	float3 diff = albedo * (1 - metal);
+	float3 f0 = lerp(0.04, albedo, metal);
+	if (plainLegacy) f0 *= 0.3;                  // old models without PBR maps: barely any specular (rend2 gives them almost none)
+	float viewZ = ViewDepth(depth);
+	float pxJitter = frac(52.9829189 * frac(dot(float2(px), float2(0.06711056, 0.00583715)) + indices2.w * 0.618));
+
+	float3 Lo = 0;
+	// sun
+	float3 L = sunDir.xyz;
+	if (foliage && sunColor.w > 0) {
+		// leaves: lit on the side facing the sun, and glowing through (a warmer, yellower green) when the sun is behind
+		// them; the forward-scatter lobe brightens canopies seen against the sun like Cycles' translucent BSDF
+		float nl = dot(N, L);
+		float sh = Shadow(P, nl < 0 ? -N : N, viewZ);
+		float3 thru = diff * float3(1.05, 1.1, 0.55);
+		float fwd = pow(saturate(dot(-V, L)), 4);
+		Lo += (diff * saturate(nl) + thru * saturate(-nl) * 0.65 + thru * fwd * 0.35) / PI * sunColor.rgb * sunColor.w * sh;
+		if (nl > 0) Lo += Brdf(N, V, L, 0, f0, max(rough, 0.5)) * sunColor.rgb * sunColor.w * sh * 0.5;
+	}
+	else if (skin && sunColor.w > 0) {
+		// wrapped diffuse with a warm scattered terminator (light bleeding through skin), GGX on top
+		float nl = dot(N, L);
+		float wrap = saturate((nl + 0.45) / 1.45);
+		float sh = Shadow(P, N, viewZ);
+		float3 scatter = lerp(float3(1.0, 0.35, 0.22), 1.0, saturate(nl * 2.0));
+		Lo += diff / PI * wrap * scatter * sunColor.rgb * sunColor.w * lerp(0.35, 1.0, sh);
+		if (nl > 0) Lo += (Brdf(N, V, L, 0, f0, rough)) * sunColor.rgb * sunColor.w * sh;
+	}
+	else if (sunColor.w > 0 && dot(N, L) > 0) {
+		float sh = Shadow(P, N, viewZ);
+		if ((lflags & 8) && sh > 0.01) sh *= ScreenShadow(P, N, L, 24 + viewZ * 0.004, 10, 6 + viewZ * 0.002, pxJitter);
+		Lo += Brdf(N, V, L, diff, f0, rough) * sunColor.rgb * sunColor.w * sh;
+	}
+	// local lights (the strongest few get screen-space shadows)
+	uint shadowed = 0;
+	for (uint i = 0; i < lightCount; i++) {
+		Light l = LoadLight(i);
+		if (l.type == 2) {
+			// line light (lightsaber): nearest point on the segment for diffuse, the point nearest the reflection
+			// ray for the highlight
+			float3 A = l.pos, Bv = l.dir;
+			float len2 = max(dot(Bv, Bv), 1e-4);
+			float tP = saturate(dot(P - A, Bv) / len2);
+			float3 Cd = A + Bv * tP - P;
+			float dd2 = dot(Cd, Cd);
+			if (dd2 > l.radius * l.radius) continue;
+			float wnd = saturate(1 - pow(dd2 / (l.radius * l.radius), 2)); wnd *= wnd;
+			float att = wnd * l.invSquare / max(dd2, 400.0);
+			float3 Rr = reflect(-V, N);
+			float3 A0 = A - P;
+			float rb = dot(Rr, Bv), ra = dot(Rr, A0);
+			float tR = saturate((dot(A0, Bv) * 0 + ra * rb - dot(A0, Bv)) / max(len2 - rb * rb, 1e-3));
+			float3 Cs = A + Bv * tR - P;
+			float3 Ldiff = Cd * rsqrt(max(dd2, 1e-4)), Lspec = Cs * rsqrt(max(dot(Cs, Cs), 1e-4));
+			float NoLd = saturate(dot(N, Ldiff));
+			if ((lflags & 16) && shadowed < 3 && NoLd > 0 && att * Luminance(l.color) > 0.02) {
+				shadowed++;
+				float sdist = min(sqrt(dd2), 320.0);
+				float s = ScreenShadow(P, N, Ldiff, sdist, 14, 40, pxJitter);
+				att *= s;
+			}
+			Lo += diff / PI * NoLd * l.color * att;
+			Lo += (Brdf(N, V, Lspec, 0, f0, max(rough, 0.12)) ) * l.color * att;
+			continue;
+		}
+		float3 d = l.pos - P;
+		float d2 = dot(d, d);
+		if (d2 > l.radius * l.radius) continue;
+		float dl = sqrt(d2);
+		float3 Ld = d / max(dl, 1e-4);
+		float w = saturate(1 - pow(d2 / (l.radius * l.radius), 2));
+		w *= w;
+		float att = l.invSquare > 0 ? w * l.invSquare / max(d2, 64.0) : w;
+		if (l.type == 1) att *= smoothstep(l.spotCos, l.spotInner, dot(-Ld, l.dir));
+		if (att <= 0) continue;
+		if ((lflags & 16) && shadowed < 3 && dot(N, Ld) > 0 && att * Luminance(l.color) > 0.02) {
+			shadowed++;
+			att *= ScreenShadow(P, N, Ld, min(dl, 320.0), 14, 40, pxJitter);
+		}
+		Lo += Brdf(N, V, Ld, diff, f0, rough) * l.color * att;
+	}
+	// ambient
+	float NoV = max(dot(N, V), 1e-4);
+	float3 R = reflect(-V, N);
+	float3 env = EnvBRDFApprox(f0, rough, NoV);
+	float specOcc = saturate(pow(NoV + ao, exp2(-16 * rough - 1)) - 1 + ao);
+	float3 spec = 0;
+	float ssrHit = 0;
+	float probeW = 0;
+	{
+		// rough reflections: a small cone of sky samples around R
+		float3 t = normalize(abs(R.z) < 0.99 ? cross(R, float3(0, 0, 1)) : cross(R, float3(1, 0, 0)));
+		float3 b = cross(R, t);
+		float cone = rough * rough * 1.2;
+		if (indices2.x) spec = SkyRadianceLod(R, rough * (SkyMips() - 1) * 0.8) * asfloat(indices2.z);
+		else {
+			float3 acc = SkyRadiance(R);
+			[unroll] for (int k = 0; k < 6; k++) {
+				float a = k * (2 * PI / 6);
+				acc += SkyRadiance(normalize(R + (t * cos(a) + b * sin(a)) * cone));
+			}
+			spec = acc / 7.0;
+		}
+		// below the horizon the "sky" is the ground: darken reflections that point down
+		spec *= saturate(R.z * 4 + 0.6);
+		// reflection probes: what is really around (rooms, walls, the ground) instead of the open sky
+		if (probeParams.y) {
+			float3 pc = SampleProbes(P, R, rough, probeW);
+			spec = lerp(spec, pc * asfloat(probeParams.z) / max(skyParams.z, 1e-3), probeW);
+		}
+		// screen-space reflections from last frame's lit scene
+		if (ssrSrv && rough < 0.45 && !plainLegacy) {
+			float3 O = P + N * (2.0 + viewZ * 0.002);
+			float stepLen = 6.0 + viewZ * 0.01;
+			float jit = frac(52.9829189 * frac(dot(float2(px), float2(0.06711056, 0.00583715)) + indices2.w * 0.618));
+			float3 Q = O + R * stepLen * jit;
+			float hit = 0; float2 huv = 0;
+			[loop] for (int sI = 0; sI < 40; sI++) {
+				Q += R * stepLen;
+				stepLen *= 1.08;
+				float4 cp = mul(viewProj, float4(Q, 1));
+				if (cp.w <= 0) break;
+				float2 suv = cp.xy / cp.w * float2(0.5, -0.5) + 0.5;
+				if (any(suv < 0) || any(suv > 1)) break;
+				float2 spx = viewport.xy + suv * viewport.zw;
+				float sd = Tex2D[indices0.w].Load(int3(spx, 0)).r;
+				float rayZ = ViewDepth(cp.z / cp.w), sceneZ = ViewDepth(sd);
+				float diffZ = rayZ - sceneZ;
+				if (sd > 0 && diffZ > 0 && diffZ < stepLen * 2.5) {
+					float4 pp = mul(prevViewProj, float4(Q, 1));
+					huv = pp.xy / pp.w * float2(0.5, -0.5) + 0.5;
+					float2 e = saturate(min(huv, 1 - huv) * 10);
+					hit = e.x * e.y * saturate(1 - sI / 40.0) * saturate((0.45 - rough) / 0.2);
+					break;
+				}
+			}
+			if (hit > 0) {
+				float3 sc = Tex2D[ssrSrv].SampleLevel(sClamp, (viewport.xy + huv * viewport.zw) * invTargetSize.xy, 0).rgb;
+				sc = min(sc, 64.0);                              // no fireflies from the sun disc
+				spec = lerp(spec, sc / max(skyParams.z, 1e-3), hit);
+				ssrHit = hit;
+			}
+		}
+	}
+	if (baked) {
+		Lo += g2 * ao;
+		// old BSP maps: no sky light to reflect (their light grid / lightmaps carry it) - only the probes and SSR
+		Lo += spec * env * specOcc * lerp(0.35 * skyParams.w, 1.0, max(probeW, ssrHit));
+	}
+	else {
+		Lo += SkyAmbient(N) * diff * ao * skyParams.z;
+		Lo += spec * env * specOcc * skyParams.z * (plainLegacy ? 0.25 : 1.0);
+		Lo += g2;
+	}
+	Lo = ApplyFog(Lo, P, V, dist);
+	if (debugMode == 1) Lo = albedo;
+	else if (debugMode == 2) Lo = N * 0.5 + 0.5;
+	else if (debugMode == 3) Lo = ao;
+	else if (debugMode == 4) Lo = Shadow(P, N, viewZ);
+	if (debugMode) Lo /= max(Exposure(), 1e-6);
+	UavTex[outUav][px] = float4(Sane(Lo), 1);
+}
diff --git a/code/rd-katarn/katarn/shaders/post.hlsl b/code/rd-katarn/katarn/shaders/post.hlsl
new file mode 100644
index 00000000..0d95fb78
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/post.hlsl
@@ -0,0 +1,202 @@
+// KatarnEngine - camera: auto exposure, bloom, filmic tone mapping, FXAA
+#include "common.hlsli"
+
+cbuffer Draw : register(b0)
+{
+	uint srcSrv;
+	uint dstUav;
+	uint histBuf;      // RW: 64 bins + exposure state
+	uint bloomSrv;
+	uint2 dstSize;
+	float dt;
+	uint pmode;
+};
+
+static const float HMin = -10.0, HMax = 8.0;
+groupshared uint ghist[64];
+
+[numthreads(16, 16, 1)]
+void HistogramCS(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex)
+{
+	if (gi < 64) ghist[gi] = 0;
+	GroupMemoryBarrierWithGroupSync();
+	if (id.x < (uint)viewport.z / 2 && id.y < (uint)viewport.w / 2) {
+		uint2 px = id.xy * 2 + (uint2)viewport.xy;
+		float l = Luminance(Tex2D[srcSrv].Load(int3(px, 0)).rgb);
+		uint bin = l < 1e-6 ? 0 : (uint)clamp((log2(l) - HMin) / (HMax - HMin) * 62.0 + 1.0, 1.0, 63.0);
+		// weight the centre of the screen more (photographers meter the subject)
+		float2 c = (float2(id.xy) / (viewport.zw * 0.5)) - 0.5;
+		uint w = (uint)(1 + 3 * saturate(1 - dot(c, c) * 3));
+		InterlockedAdd(ghist[bin], w);
+	}
+	GroupMemoryBarrierWithGroupSync();
+	if (gi < 64 && ghist[gi]) UAVBUF(histBuf).InterlockedAdd(16 + gi * 4, ghist[gi]);
+}
+
+[numthreads(64, 1, 1)]
+void ExposureCS(uint gi : SV_GroupIndex)
+{
+	ghist[gi] = UAVBUF(histBuf).Load(16 + gi * 4);
+	GroupMemoryBarrierWithGroupSync();
+	if (gi == 0) {
+		float total = 0;
+		for (int i = 1; i < 64; i++) total += ghist[i];
+		float lo = total * 0.5, hi = total * 0.95;
+		float acc = 0, sum = 0, cnt = 0;
+		for (int j = 1; j < 64; j++) {
+			float c = ghist[j];
+			float take = clamp(acc + c, lo, hi) - clamp(acc, lo, hi);
+			acc += c;
+			float lum = (j - 1) / 62.0 * (HMax - HMin) + HMin;
+			sum += lum * take; cnt += take;
+		}
+		float avgLog = cnt > 0 ? sum / cnt : -2.0;
+		float avg = exp2(avgLog);
+		float target = 0.18 / max(avg, 1e-5) * exp2(postParams.x);
+		float prev = asfloat(UAVBUF(histBuf).Load(0));
+		if (!(prev > 0) || prev > 1e9) prev = target;
+		float speed = target > prev ? 2.5 : 1.2;
+		float e = prev + (target - prev) * (1 - exp(-dt * speed));
+		if (postParams.z > 0) e = postParams.z;
+		e = clamp(e, 1e-6, 1e6);
+		UAVBUF(histBuf).Store2(0, asuint(float2(e, avg)));
+	}
+	GroupMemoryBarrierWithGroupSync();
+	UAVBUF(histBuf).Store(16 + gi * 4, 0);
+}
+
+// ---------------------------------------------------------------- bloom
+float3 Fetch(uint tex, float2 uv) { return Sane(Tex2D[tex].SampleLevel(sClamp, uv, 0).rgb); }
+
+[numthreads(8, 8, 1)]
+void BloomDownCS(uint3 id : SV_DispatchThreadID)
+{
+	if (any(id.xy >= dstSize)) return;
+	float2 ts = 1.0 / float2(dstSize);
+	float2 uv = (id.xy + 0.5) * ts;
+	float2 h = ts * 0.5;
+	if (pmode == 0) {
+		// first level: from the HDR scene inside the view, exposed, fireflies tamed, soft threshold
+		uv = (viewport.xy + uv * viewport.zw) * invTargetSize.xy;
+		h = invTargetSize.xy;
+	}
+	float3 a = Fetch(srcSrv, uv + float2(-2, -2) * h), b = Fetch(srcSrv, uv + float2(0, -2) * h), c = Fetch(srcSrv, uv + float2(2, -2) * h);
+	float3 d = Fetch(srcSrv, uv + float2(-1, -1) * h), e = Fetch(srcSrv, uv + float2(1, -1) * h);
+	float3 f = Fetch(srcSrv, uv + float2(-2, 0) * h), g0 = Fetch(srcSrv, uv), hh = Fetch(srcSrv, uv + float2(2, 0) * h);
+	float3 i = Fetch(srcSrv, uv + float2(-1, 1) * h), j = Fetch(srcSrv, uv + float2(1, 1) * h);
+	float3 k = Fetch(srcSrv, uv + float2(-2, 2) * h), l = Fetch(srcSrv, uv + float2(0, 2) * h), m = Fetch(srcSrv, uv + float2(2, 2) * h);
+	float3 r;
+	if (pmode == 0) {
+		float ex = Exposure();
+		float3 g1 = (d + e + i + j) * 0.25, g2 = (a + b + g0 + f) * 0.25, g3 = (b + c + hh + g0) * 0.25, g4 = (f + g0 + k + l) * 0.25, g5 = (g0 + hh + l + m) * 0.25;
+		float w1 = 1 / (1 + Luminance(g1) * ex), w2 = 1 / (1 + Luminance(g2) * ex), w3 = 1 / (1 + Luminance(g3) * ex), w4 = 1 / (1 + Luminance(g4) * ex), w5 = 1 / (1 + Luminance(g5) * ex);
+		r = (g1 * w1 * 0.5 + (g2 * w2 + g3 * w3 + g4 * w4 + g5 * w5) * 0.125) / (w1 * 0.5 + (w2 + w3 + w4 + w5) * 0.125);
+		r *= ex;
+		float br = max(r.r, max(r.g, r.b));
+		float knee = 0.5, thr = 1.0;
+		float soft = clamp(br - thr + knee, 0, 2 * knee);
+		soft = soft * soft / (4 * knee + 1e-4);
+		r *= max(soft, br - thr) / max(br, 1e-4);
+		if (histBuf) {
+			// rend2 dynamic glow: the glow stages, blurred with the bloom (no threshold)
+			float3 gl = 0;
+			[unroll] for (int gy = -1; gy <= 1; gy++) [unroll] for (int gx = -1; gx <= 1; gx++) gl += Fetch(histBuf, uv + float2(gx, gy) * h);
+			r += gl / 9.0 * ex * dt;
+		}
+	}
+	else r = (d + e + i + j) * 0.125 + (a + c + k + m) * 0.03125 + (b + f + hh + l) * 0.0625 + g0 * 0.125;
+	UavTex[dstUav][id.xy] = float4(r, 1);
+}
+
+[numthreads(8, 8, 1)]
+void BloomUpCS(uint3 id : SV_DispatchThreadID)
+{
+	if (any(id.xy >= dstSize)) return;
+	float2 uv = (id.xy + 0.5) / float2(dstSize);
+	float2 h = 1.0 / float2(dstSize);
+	float3 s = Fetch(bloomSrv, uv + float2(-1, -1) * h) + Fetch(bloomSrv, uv + float2(1, -1) * h) + Fetch(bloomSrv, uv + float2(-1, 1) * h) + Fetch(bloomSrv, uv + float2(1, 1) * h);
+	s += 2 * (Fetch(bloomSrv, uv + float2(0, -1) * h) + Fetch(bloomSrv, uv + float2(-1, 0) * h) + Fetch(bloomSrv, uv + float2(1, 0) * h) + Fetch(bloomSrv, uv + float2(0, 1) * h));
+	s += 4 * Fetch(bloomSrv, uv);
+	s /= 16;
+	float3 base = Tex2D[srcSrv].Load(int3(id.xy, 0)).rgb;
+	UavTex[dstUav][id.xy] = float4(base + s, 1);
+}
+
+// ---------------------------------------------------------------- tone mapping (PS over the view rect)
+float3 ACESFitted(float3 c)
+{
+	const float3x3 inM = float3x3(0.59719, 0.35458, 0.04823, 0.07600, 0.90834, 0.01566, 0.02840, 0.13383, 0.83777);
+	const float3x3 outM = float3x3(1.60475, -0.53108, -0.07367, -0.10208, 1.10813, -0.00605, -0.00327, -0.07276, 1.07602);
+	c = mul(inM, c);
+	float3 a = c * (c + 0.0245786) - 0.000090537;
+	float3 b = c * (0.983729 * c + 0.4329510) + 0.238081;
+	return saturate(mul(outM, a / b));
+}
+
+// AgX (Blender's default view transform since 4.0): inset into a wider gamut, log2 encoding over -12.47..+4.03 EV
+// around middle grey, the AgX sigmoid, outset back. Same image formation as the Blender renders the worlds come from.
+float3 AgxContrast(float3 x)
+{
+	float3 x2 = x * x, x4 = x2 * x2;
+	return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
+}
+float3 AgX(float3 c)
+{
+	const float3x3 inset = float3x3(0.842479062253094, 0.0784335999999992, 0.0792237451477643,
+	                                0.0423282422610123, 0.878468636469772, 0.0791661274605434,
+	                                0.0423756549057051, 0.0784336, 0.879142973793104);
+	const float3x3 outset = float3x3(1.19687900512017, -0.0980208811401368, -0.0990297440797205,
+	                                 -0.0528968517574562, 1.15190312990417, -0.0989611768448433,
+	                                 -0.0529716355144438, -0.0980434501171241, 1.15107367264116);
+	const float minEv = -12.47393, maxEv = 4.026069;
+	c = mul(inset, max(c, 1e-10));
+	c = saturate((log2(c) - minEv) / (maxEv - minEv));
+	c = AgxContrast(c);
+	c = mul(outset, c);
+	return pow(saturate(c), 2.2);   // display-referred, linearised again for the sRGB encode below
+}
+
+float4 TonemapPS(FsOut i) : SV_Target0
+{
+	float2 uv = (viewport.xy + i.uv * viewport.zw) * invTargetSize.xy;
+	// sky portal maps: pixels the main view drew nothing on (depth 0) keep the portal view drawn before it. Only then:
+	// an ordinary sky box writes no depth either, and discarding it left last frame's picture (hall-of-mirrors sky)
+	if (extraParams.z > 0.5 && skyParams.w <= 0.5 && Tex2D[indices0.w].Load(int3(i.pos.xy, 0)).r <= 0.0) discard;
+	float3 c = Sane(Tex2D[srcSrv].SampleLevel(sClampPoint, uv, 0).rgb) * Exposure();
+	if (bloomSrv) c += Tex2D[bloomSrv].SampleLevel(sClamp, i.uv, 0).rgb * postParams.y;
+	if (skyParams.w > 0.5) {
+		c = extraParams.y > 0.5 ? AgX(c) : ACESFitted(c * 1.4);
+		float2 v = i.uv - 0.5;
+		c *= 1 - dot(v, v) * 0.2;
+	}
+	else c = saturate(saturate(c) * Overbright());   // legacy BSP maps: display-referred, plus the overbright shift the old gamma ramp did
+	c = LinearToSrgb(c);
+	float n = frac(sin(dot(i.pos.xy + indices2.w * 0.37, float2(12.9898, 78.233))) * 43758.5453);
+	c += (n - 0.5) / 255.0;
+	return float4(c, dot(c, float3(0.299, 0.587, 0.114)));
+}
+
+// FXAA (console quality) on the tone mapped image, luma in alpha
+float4 FxaaPS(FsOut i) : SV_Target0
+{
+	float2 rcp = 1.0 / float2(dstSize);
+	float2 uv = (viewport.xy + i.uv * viewport.zw) * rcp;
+	// sky portal maps: pixels the main view drew nothing on (depth 0) keep the portal view drawn before it. Only then:
+	// an ordinary sky box writes no depth either, and discarding it left last frame's picture (hall-of-mirrors sky)
+	if (extraParams.z > 0.5 && skyParams.w <= 0.5 && Tex2D[indices0.w].Load(int3(i.pos.xy, 0)).r <= 0.0) discard;
+	float4 m = Tex2D[srcSrv].SampleLevel(sClamp, uv, 0);
+	float nw = Tex2D[srcSrv].SampleLevel(sClamp, uv + float2(-0.5, -0.5) * rcp, 0).a;
+	float ne = Tex2D[srcSrv].SampleLevel(sClamp, uv + float2(0.5, -0.5) * rcp, 0).a;
+	float sw = Tex2D[srcSrv].SampleLevel(sClamp, uv + float2(-0.5, 0.5) * rcp, 0).a;
+	float se = Tex2D[srcSrv].SampleLevel(sClamp, uv + float2(0.5, 0.5) * rcp, 0).a;
+	float lmax = max(max(nw, ne), max(sw, se)), lmin = min(min(nw, ne), min(sw, se));
+	if (max(lmax, m.a) - min(lmin, m.a) < max(0.05, lmax * 0.125)) return float4(m.rgb, 1);
+	float2 dir = float2(-((nw + ne) - (sw + se)), (nw + sw) - (ne + se));
+	float red = max((nw + ne + sw + se) * 0.03125, 1.0 / 128.0);
+	float rmin = 1.0 / (min(abs(dir.x), abs(dir.y)) + red);
+	dir = clamp(dir * rmin, -8.0, 8.0) * rcp;
+	float3 a = 0.5 * (Tex2D[srcSrv].SampleLevel(sClamp, uv - dir / 6, 0).rgb + Tex2D[srcSrv].SampleLevel(sClamp, uv + dir / 6, 0).rgb);
+	float3 b = a * 0.5 + 0.25 * (Tex2D[srcSrv].SampleLevel(sClamp, uv - dir * 0.5, 0).rgb + Tex2D[srcSrv].SampleLevel(sClamp, uv + dir * 0.5, 0).rgb);
+	float lb = dot(b, float3(0.299, 0.587, 0.114));
+	return float4((lb < min(lmin, m.a) || lb > max(lmax, m.a)) ? a : b, 1);
+}
diff --git a/code/rd-katarn/katarn/shaders/present.hlsl b/code/rd-katarn/katarn/shaders/present.hlsl
new file mode 100644
index 00000000..169a54c8
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/present.hlsl
@@ -0,0 +1,17 @@
+// KatarnEngine - final copy of the screen target to the swap chain (gamma like r_gamma did with hardware ramps)
+#include "common.hlsli"
+
+cbuffer Draw : register(b0)
+{
+	uint srcTex;
+	float gamma;
+	float brightness;
+	uint presentPad;
+};
+
+float4 PS(FsOut i) : SV_Target0
+{
+	float3 c = Tex2D[srcTex].SampleLevel(sClampPoint, i.uv, 0).rgb;
+	c = pow(saturate(c * brightness), 1.0 / gamma);
+	return float4(c, 1);
+}
diff --git a/code/rd-katarn/katarn/shaders/probes.hlsl b/code/rd-katarn/katarn/shaders/probes.hlsl
new file mode 100644
index 00000000..4723a3cd
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/probes.hlsl
@@ -0,0 +1,54 @@
+// KatarnEngine - reflection probe filtering: each mip of a captured cube is a wider cone of the level above it, so
+// rougher surfaces read blurrier reflections (sampled across face edges, no seams)
+#include "common.hlsli"
+
+cbuffer Draw : register(b0)
+{
+	uint srcSrv;     // the level above, Texture2DArray of the six faces
+	uint dstUav;     // this level, RWTexture2DArray
+	uint dstSize;
+	uint mip;
+};
+
+// D3D cube face conventions (face, s, t in -1..1) <-> direction
+float3 FaceDir(uint face, float2 st)
+{
+	float s = st.x, t = st.y;
+	if (face == 0) return float3(1, -t, -s);
+	if (face == 1) return float3(-1, -t, s);
+	if (face == 2) return float3(s, 1, t);
+	if (face == 3) return float3(s, -1, -t);
+	if (face == 4) return float3(s, -t, 1);
+	return float3(-s, -t, -1);
+}
+
+float3 Fetch(float3 d)
+{
+	float3 a = abs(d);
+	uint face; float ma, sc, tc;
+	if (a.x >= a.y && a.x >= a.z) { face = d.x > 0 ? 0 : 1; ma = a.x; sc = d.x > 0 ? -d.z : d.z; tc = -d.y; }
+	else if (a.y >= a.z) { face = d.y > 0 ? 2 : 3; ma = a.y; sc = d.x; tc = d.y > 0 ? d.z : -d.z; }
+	else { face = d.z > 0 ? 4 : 5; ma = a.z; sc = d.z > 0 ? d.x : -d.x; tc = -d.y; }
+	float2 uv = float2(sc, tc) / ma * 0.5 + 0.5;
+	return Tex2DArray[srcSrv].SampleLevel(sClamp, float3(uv, face), 0).rgb;
+}
+
+[numthreads(8, 8, 1)]
+void FilterCS(uint3 id : SV_DispatchThreadID)
+{
+	if (id.x >= dstSize || id.y >= dstSize) return;
+	float3 d = normalize(FaceDir(id.z, (id.xy + 0.5) / dstSize * 2.0 - 1.0));
+	float3 t = normalize(cross(abs(d.z) < 0.99 ? float3(0, 0, 1) : float3(1, 0, 0), d));
+	float3 b = cross(d, t);
+	float r = 2.0 / dstSize * (0.6 + 0.12 * mip);   // a bit more than this texel's footprint
+	float3 acc = 0;
+	float wsum = 0;
+	[loop] for (int j = 0; j < 5; j++)
+		[loop] for (int i = 0; i < 5; i++) {
+			float2 o = float2(i, j) * 0.5 - 1.0;
+			float w = exp(-2.0 * dot(o, o));
+			acc += min(Fetch(normalize(d + (t * o.x + b * o.y) * r)), 512.0) * w;
+			wsum += w;
+		}
+	UavTexArray[dstUav][id] = float4(acc / wsum, 1);
+}
diff --git a/code/rd-katarn/katarn/shaders/saber.hlsl b/code/rd-katarn/katarn/shaders/saber.hlsl
new file mode 100644
index 00000000..d57bb486
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/saber.hlsl
@@ -0,0 +1,84 @@
+// KatarnEngine - lightsaber blades in the style of Star Wars Battlefront II (2017): a thin, white-hot core with a
+// saturated coloured edge, a tight bright inner glow and a wide soft outer glow, rounded ends, a slight hum
+// flicker. Drawn into the HDR scene (bloom does the rest), occluded by the scene depth.
+// bladeAlpha 1 = darksaber: a black core with a white rim. Premultiplied output: rgb + dst * (1 - a).
+#include "common.hlsli"
+
+cbuffer Blade : register(b0)
+{
+	float3 bladeA; float glowR;      // hilt, glow radius (the game's saber radius)
+	float3 bladeB; float coreR;      // tip, core radius
+	float3 bladeColor; float bladeIntensity;
+	uint bladeTex; uint bladeMode; uint bladeAlpha; uint bladePad;
+	float3 vertexColor; float bladePad2;
+};
+
+struct VsOut { float4 pos : SV_Position; float3 wpos : TEXCOORD0; };
+
+VsOut VS(uint vid : SV_VertexID)
+{
+	float3 ax = bladeB - bladeA;
+	float len = max(length(ax), 1e-3);
+	float3 d = ax / len;
+	float3 mid = (bladeA + bladeB) * 0.5;
+	float3 toCam = normalize(camPos.xyz - mid);
+	float3 side = cross(d, toCam);
+	side = dot(side, side) > 1e-6 ? normalize(side) : normalize(cross(d, float3(0, 0, 1)));
+	float w = bladeAlpha == 2 ? coreR * 2.0 : glowR * 2.2;
+	static const float2 c[6] = { float2(-1, -1), float2(1, -1), float2(1, 1), float2(-1, -1), float2(1, 1), float2(-1, 1) };
+	float2 q = c[vid];
+	float3 p = (q.y < 0 ? bladeA - d * w : bladeB + d * w) + side * q.x * w + toCam * w;
+	VsOut o;
+	o.pos = mul(viewProj, float4(p, 1));
+	o.wpos = p;
+	return o;
+}
+
+float4 PS(VsOut i) : SV_Target0
+{
+	// distance from the view ray to the blade segment (a capsule: rounded tip)
+	float3 ro = camPos.xyz, rd = normalize(i.wpos - ro);
+	float3 ab = bladeB - bladeA, ao = ro - bladeA;
+	float a = dot(ab, ab), b = dot(ab, rd), c = dot(ab, ao), e = dot(rd, ao);
+	float s = saturate((c - b * e) / max(a - b * b, 1e-6));
+	float3 Pb = bladeA + ab * s;
+	float t = max(dot(Pb - ro, rd), 0);
+	float dist = length(ro + rd * t - Pb);
+
+	float sd = Tex2D[indices0.w].Load(int3(i.pos.xy, 0)).r;
+	float4 cp = mul(viewProj, float4(Pb, 1));
+	float bd = cp.z / max(cp.w, 1e-4);
+	float vis = (sd > 0 && ViewDepth(sd) < ViewDepth(bd) - glowR * 0.5) ? 0.0 : 1.0;
+
+	// hum: a slight flicker along and over time
+	float tm = projParams.w;
+	float hum = 1.0 + 0.035 * sin(tm * 47.0 + s * 9.0) + 0.025 * sin(tm * 113.0);
+
+	float rc = max(coreR, 0.35);                     // core radius
+	float w = glowR * 2.2;
+	float window = saturate(1 - dist / w); window *= window;
+	float core = 1 - smoothstep(rc * 0.55, rc * 1.25, dist);           // white-hot centre
+	float edge = exp(-pow(dist / (rc * 1.9), 2)) * (1 - core);        // saturated rim right outside the core
+	float inner = exp(-pow(dist / (rc * 3.5), 2));
+	float outer = exp(-pow(dist / (glowR * 0.95), 2)) * window;
+	float scale = bladeIntensity / max(Exposure(), 1e-6) * vis * hum;
+
+	if (bladeAlpha == 2) {
+		// core only (over the game's own glow): solid white-hot, the blade colour only at its very edge
+		float cc = 1 - smoothstep(coreR * 0.45, coreR, dist);
+		float3 col = lerp(bladeColor, 1.0, saturate(1.4 - dist / coreR)) * 6.0 / max(Exposure(), 1e-6) * vis;
+		return float4(Sane(col * cc), saturate(cc * vis));
+	}
+	if (bladeAlpha) {
+		// darksaber: black core, white crackling rim
+		float rim = (edge * 3.0 + inner * 0.6 + outer * 0.2);
+		float3 col = float3(1, 1, 1) * rim * scale;
+		return float4(Sane(col), saturate(core * vis));
+	}
+	float3 C = bladeColor;
+	float3 col = 1.0 * core * 14.0
+		+ C * edge * 9.0
+		+ C * inner * 3.0
+		+ C * outer * 0.9;
+	return float4(Sane(col * scale), 0);
+}
diff --git a/code/rd-katarn/katarn/shaders/sky.hlsl b/code/rd-katarn/katarn/shaders/sky.hlsl
new file mode 100644
index 00000000..9f0c9934
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/sky.hlsl
@@ -0,0 +1,130 @@
+// KatarnEngine - physically based sky: single-scattering Rayleigh + Mie into a lat-long LUT, and its irradiance as SH
+#include "common.hlsli"
+
+cbuffer Draw : register(b0)
+{
+	uint lutUav;
+	uint lutSrv;
+	uint shUav;
+	uint lutW;
+	uint lutH;
+	float groundAlbedo;
+	uint skyPad0;
+	uint skyPad1;
+};
+
+static const float Rg = 6360.0, Rt = 6460.0;
+static const float3 BetaR = float3(5.802e-3, 13.558e-3, 33.1e-3);
+static const float BetaM = 3.996e-3, BetaMExt = 4.44e-3;
+static const float HR = 8.0, HM = 1.2;
+
+float2 RaySphere(float3 o, float3 d, float r)
+{
+	float b = dot(o, d), c = dot(o, o) - r * r, h = b * b - c;
+	if (h < 0) return float2(-1, -1);
+	h = sqrt(h);
+	return float2(-b - h, -b + h);
+}
+
+float3 Transmittance(float3 p, float3 l)
+{
+	float2 t = RaySphere(p, l, Rt);
+	float len = t.y;
+	float2 od = 0;
+	const int N = 8;
+	float ds = len / N;
+	for (int i = 0; i < N; i++) {
+		float h = length(p + l * ((i + 0.5) * ds)) - Rg;
+		od += exp(-float2(h / HR, h / HM)) * ds;
+	}
+	return exp(-(BetaR * od.x + BetaMExt * od.y * (1.0 + skyParams.x)));
+}
+
+float3 Atmosphere(float3 dir)
+{
+	float3 L = sunDir.xyz;
+	float3 o = float3(0, 0, Rg + 0.25);
+	float2 ta = RaySphere(o, dir, Rt);
+	float2 tg = RaySphere(o, dir, Rg);
+	bool ground = tg.x > 0;
+	float len = ground ? tg.x : ta.y;
+	len = min(len, 400.0);
+	const int N = 24;
+	float ds = len / N;
+	float3 sumR = 0, sumM = 0;
+	float2 od = 0;
+	for (int i = 0; i < N; i++) {
+		float3 p = o + dir * ((i + 0.5) * ds);
+		float h = length(p) - Rg;
+		float2 dens = exp(-float2(h / HR, h / HM)) * ds;
+		od += dens;
+		float3 tv = exp(-(BetaR * od.x + BetaMExt * od.y * (1.0 + skyParams.x)));
+		// sun visible from p?
+		float2 tgl = RaySphere(p, L, Rg);
+		if (tgl.x > 0) continue;
+		float3 tl = Transmittance(p, L);
+		sumR += dens.x * tv * tl;
+		sumM += dens.y * tv * tl;
+	}
+	float mu = dot(dir, L);
+	float pr = 3.0 / (16.0 * PI) * (1.0 + mu * mu);
+	float g = 0.76;
+	float pm = 3.0 / (8.0 * PI) * ((1.0 - g * g) * (1.0 + mu * mu)) / ((2.0 + g * g) * pow(abs(1.0 + g * g - 2.0 * g * mu), 1.5));
+	float3 c = sumR * BetaR * pr + sumM * BetaM * (1.0 + skyParams.x) * pm;
+	if (ground) {
+		float3 p = o + dir * tg.x;
+		float3 n = normalize(p);
+		float3 tv = exp(-(BetaR * od.x + BetaMExt * od.y));
+		c += tv * Transmittance(p, L) * saturate(dot(n, L)) * groundAlbedo / PI;
+	}
+	return c * sunColor.rgb * sunColor.w * skyParams.y;
+}
+
+float3 LutDir(float2 uv)
+{
+	float phi = (uv.x - 0.5) * 2 * PI;
+	float el = (0.5 - uv.y) * PI;
+	return float3(cos(el) * cos(phi), cos(el) * sin(phi), sin(el));
+}
+
+[numthreads(8, 8, 1)]
+void LutCS(uint3 id : SV_DispatchThreadID)
+{
+	if (id.x >= lutW || id.y >= lutH) return;
+	float2 uv = (id.xy + 0.5) / float2(lutW, lutH);
+	UavTex[lutUav][id.xy] = float4(Atmosphere(LutDir(uv)), 1);
+}
+
+groupshared float3 shAcc[256][9];
+
+[numthreads(256, 1, 1)]
+void ShCS(uint3 gt : SV_GroupThreadID)
+{
+	float3 acc[9];
+	for (int k = 0; k < 9; k++) acc[k] = 0;
+	uint total = lutW * lutH;
+	for (uint i = gt.x; i < total; i += 256) {
+		uint2 p = uint2(i % lutW, i / lutW);
+		float2 uv = (p + 0.5) / float2(lutW, lutH);
+		float3 d = LutDir(uv);
+		float el = (0.5 - uv.y) * PI;
+		float w = cos(el) * (2 * PI / lutW) * (PI / lutH);
+		float3 c = Tex2D[lutSrv].Load(int3(p, 0)).rgb * w;
+		acc[0] += c * 0.282095;
+		acc[1] += c * 0.488603 * d.y; acc[2] += c * 0.488603 * d.z; acc[3] += c * 0.488603 * d.x;
+		acc[4] += c * 1.092548 * d.x * d.y; acc[5] += c * 1.092548 * d.y * d.z;
+		acc[6] += c * 0.315392 * (3 * d.z * d.z - 1);
+		acc[7] += c * 1.092548 * d.x * d.z; acc[8] += c * 0.546274 * (d.x * d.x - d.y * d.y);
+	}
+	for (int k2 = 0; k2 < 9; k2++) shAcc[gt.x][k2] = acc[k2];
+	GroupMemoryBarrierWithGroupSync();
+	for (uint s = 128; s > 0; s >>= 1) {
+		if (gt.x < s) for (int k3 = 0; k3 < 9; k3++) shAcc[gt.x][k3] += shAcc[gt.x + s][k3];
+		GroupMemoryBarrierWithGroupSync();
+	}
+	if (gt.x == 0) {
+		// convolve with the clamped cosine lobe -> irradiance / PI (diffuse radiance)
+		static const float A[9] = { 1.0, 2.0 / 3.0, 2.0 / 3.0, 2.0 / 3.0, 0.25, 0.25, 0.25, 0.25, 0.25 };
+		for (int k4 = 0; k4 < 9; k4++) UAVBUF(shUav).Store4(k4 * 16, asuint(float4(shAcc[0][k4] * A[k4], 0)));
+	}
+}
diff --git a/code/rd-katarn/katarn/shaders/ssao.hlsl b/code/rd-katarn/katarn/shaders/ssao.hlsl
new file mode 100644
index 00000000..cf1c3144
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/ssao.hlsl
@@ -0,0 +1,82 @@
+// KatarnEngine - screen-space ambient occlusion (horizon based) + depth-aware blur
+#include "common.hlsli"
+
+cbuffer Draw : register(b0)
+{
+	uint outUav;
+	uint inSrv;
+	float radius;       // world units
+	float intensity;
+	int2 blurDir;
+	uint aoPad0;
+	uint aoPad1;
+};
+
+float3 EyePos(uint2 px, float depth)
+{
+	float2 uv = (float2(px) - viewport.xy + 0.5) / viewport.zw;
+	float2 ndc = uv * float2(2, -2) + float2(-1, 1);
+	float z = projParams.z / max(depth, 1e-7);
+	return float3(ndc.x * z / projParams.x, ndc.y * z / projParams.y, -z);
+}
+
+float Ign(float2 p) { return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715)))); }
+
+[numthreads(8, 8, 1)]
+void AoCS(uint3 id : SV_DispatchThreadID)
+{
+	if (id.x >= (uint)viewport.z || id.y >= (uint)viewport.w) return;
+	uint2 px = id.xy + (uint2)viewport.xy;
+	float depth = Tex2D[indices0.w].Load(int3(px, 0)).r;
+	if (depth <= 0) { UavTex[outUav][px] = 1; return; }
+	float3 P = EyePos(px, depth);
+	float3 Nw = DecodeNormal(Tex2D[indices0.y].Load(int3(px, 0)).xy);
+	float3 N = normalize(mul((float3x3)worldToEye, Nw));
+	float pixRadius = radius * projParams.y * viewport.w * 0.5 / max(-P.z, 1);
+	pixRadius = min(pixRadius, 96);
+	if (pixRadius < 1.5) { UavTex[outUav][px] = 1; return; }
+	float rnd = Ign(float2(px) + (indices2.w % 8) * 7.0) * 2 * PI;
+	float occ = 0;
+	const int DIRS = 4, STEPS = 4;
+	[unroll] for (int d = 0; d < DIRS; d++) {
+		float a = rnd + d * (PI / DIRS);
+		float2 dir = float2(cos(a), sin(a));
+		[unroll] for (int s = 1; s <= STEPS; s++) {
+			float t = (s - 0.5 + frac(rnd * 3.7 + s * 0.31)) / STEPS;
+			int2 o = int2(dir * pixRadius * t);
+			[unroll] for (int side = -1; side <= 1; side += 2) {
+				int2 q = int2(px) + o * side;
+				if (q.x < viewport.x || q.y < viewport.y || q.x >= viewport.x + viewport.z || q.y >= viewport.y + viewport.w) continue;
+				float dq = Tex2D[indices0.w].Load(int3(q, 0)).r;
+				float3 Q = EyePos((uint2)q, dq);
+				float3 v = Q - P;
+				float l2 = dot(v, v);
+				float ndv = dot(N, v) * rsqrt(max(l2, 1e-4));
+				float fall = saturate(1 - l2 / (radius * radius));
+				occ += saturate(ndv - 0.1) * fall;
+			}
+		}
+	}
+	occ /= DIRS * STEPS * 2;
+	float ao = saturate(1 - occ * intensity * 2);
+	UavTex[outUav][px] = float4(ao, ao, ao, 1);
+}
+
+[numthreads(8, 8, 1)]
+void BlurCS(uint3 id : SV_DispatchThreadID)
+{
+	if (id.x >= (uint)viewport.z || id.y >= (uint)viewport.w) return;
+	uint2 px = id.xy + (uint2)viewport.xy;
+	float d0 = ViewDepth(Tex2D[indices0.w].Load(int3(px, 0)).r);
+	float sum = 0, wsum = 0;
+	[unroll] for (int i = -4; i <= 4; i++) {
+		int2 q = int2(px) + blurDir * i;
+		q = clamp(q, int2(viewport.xy), int2(viewport.xy + viewport.zw - 1));
+		float dq = ViewDepth(Tex2D[indices0.w].Load(int3(q, 0)).r);
+		float w = exp(-i * i / 8.0) * saturate(1 - abs(dq - d0) / (d0 * 0.05 + 1));
+		sum += Tex2D[inSrv].Load(int3(q, 0)).r * w;
+		wsum += w;
+	}
+	float ao = sum / max(wsum, 1e-4);
+	UavTex[outUav][px] = float4(ao, ao, ao, 1);
+}
diff --git a/code/rd-katarn/katarn/shaders/world.hlsl b/code/rd-katarn/katarn/shaders/world.hlsl
new file mode 100644
index 00000000..e529fa52
--- /dev/null
+++ b/code/rd-katarn/katarn/shaders/world.hlsl
@@ -0,0 +1,286 @@
+// KatarnEngine - HD world (.kworld) meshes: GBuffer and shadow depth
+#include "common.hlsli"
+
+cbuffer Draw : register(b0)
+{
+	uint materialBuf;     // ByteAddressBuffer: Material records
+	uint cascade;         // shadow pass: cascade index
+	uint drawMode;        // 0 gbuffer, 1 shadow
+	uint drawPad0;
+};
+
+struct Material {
+	float4 baseColor;
+	float roughness;
+	float metallic;
+	float normalScale;
+	float alphaCutoff;
+	uint albedoTex;
+	uint normalTex;
+	uint ormTex;
+	uint emissiveTex;
+	float3 emissive; uint mflags;   // 1 alpha mask, 2 two-sided, 4 orm has AO, 8 blend
+};
+Material LoadMaterial(uint i)
+{
+	uint o = i * 64;
+	Material m;
+	m.baseColor = asfloat(BUF(materialBuf).Load4(o));
+	float4 f = asfloat(BUF(materialBuf).Load4(o + 16));
+	m.roughness = f.x; m.metallic = f.y; m.normalScale = f.z; m.alphaCutoff = f.w;
+	uint4 t = BUF(materialBuf).Load4(o + 32);
+	m.albedoTex = t.x; m.normalTex = t.y; m.ormTex = t.z; m.emissiveTex = t.w;
+	uint4 e = BUF(materialBuf).Load4(o + 48);
+	m.emissive = asfloat(e.xyz); m.mflags = e.w;
+	return m;
+}
+
+struct VsIn { float3 pos : POSITION; float2 n : NORMAL; float2 t : TANGENT; float2 uv : TEXCOORD0; uint2 mat : BLENDINDICES; };
+struct VsOut {
+	float4 pos : SV_Position;
+	float3 normal : NORMAL;
+	float4 tangent : TANGENT;
+	float2 uv : TEXCOORD0;
+	float3 wpos : TEXCOORD1;
+	nointerpolation uint mat : MATERIAL;
+};
+
+VsOut VS(VsIn i)
+{
+	VsOut v;
+	v.pos = mul(drawMode == 1 ? cascadeViewProj[cascade] : viewProj, float4(i.pos, 1));
+	v.normal = DecodeNormal(i.n);
+	v.tangent = float4(DecodeNormal(i.t), i.mat.y > 32767 ? -1.0 : 1.0);
+	v.uv = i.uv;
+	v.wpos = i.pos;
+	v.mat = i.mat.x;
+	return v;
+}
+
+struct GBufferOut {
+	float4 albedo : SV_Target0;     // sRGB target: albedo, a = material AO
+	float4 normal : SV_Target1;     // oct normal xy, roughness (negative = baked lighting), metallic
+	float4 emissive : SV_Target2;   // emitted / baked radiance
+};
+
+// ---- splat (terrain) materials: tiled layers blended by world-position masks (KwSplatHeader / KwSplatLayer)
+void Splat(uint o, float3 wpos, float3 ng, out float3 albedo, out float rough, out float3 n)
+{
+	uint4 h0 = BUF(materialBuf).Load4(o);
+	float4 maskXf = asfloat(BUF(materialBuf).Load4(o + 16));
+	float4 tintXf = asfloat(BUF(materialBuf).Load4(o + 32));
+	float4 h3 = asfloat(BUF(materialBuf).Load4(o + 48));
+	uint numLayers = min(h0.x, 24u);
+	uint tintTex = h0.y;
+	float tintMul = asfloat(h0.z), normalStrength = asfloat(h0.w);
+	float invUnits = h3.x, roughConst = h3.y;
+	float2 p = wpos.xy * invUnits;                       // Blender metres
+	float2 muv = p * maskXf.xy + maskXf.zw; muv.y = 1 - muv.y;
+	albedo = 0; rough = roughConst < 0 ? 0.8 : roughConst;
+	float2 dn = 0;                                       // detail normal (tangent space, world X / Y)
+	float2 dpx = ddx(p), dpy = ddy(p);                   // gradients outside the (divergent) layer loop
+	[loop] for (uint li = 0; li < numLayers; li++) {
+		uint lo = o + 64 + li * 32;
+		uint4 a = BUF(materialBuf).Load4(lo);
+		uint4 b = BUF(materialBuf).Load4(lo + 16);
+		uint albedoTex = a.x, nohTex = a.y; float scale = asfloat(a.z); uint maskTex = a.w;
+		uint chan = b.x; float smin = asfloat(b.y), smax = asfloat(b.z); uint flags = b.w;
+		float w = 1;
+		if (li > 0) {
+			if (chan == 4) w = 1 - saturate((ng.z - smin) / max(smax - smin, 1e-4));
+			else if (maskTex) {
+				float4 m = Tex2D[NonUniformResourceIndex(maskTex)].SampleLevel(sClamp, muv, 0);
+				w = chan == 0 ? m.r : chan == 1 ? m.g : chan == 2 ? m.b : m.a;
+			}
+			else w = 0;
+		}
+		if (w <= 0.002) continue;
+		float2 luv = p * scale; luv.y = 1 - luv.y;
+		if (!(flags & 1) && albedoTex) {
+			float4 c = Tex2D[NonUniformResourceIndex(albedoTex)].SampleGrad(sWrap, luv, dpx * scale * float2(1, -1), dpy * scale * float2(1, -1));
+			albedo = lerp(albedo, c.rgb, w);
+			if (roughConst < 0) rough = lerp(rough, 1 - c.a, w);
+		}
+		if (nohTex) {
+			float2 t = Tex2D[NonUniformResourceIndex(nohTex)].SampleGrad(sWrap, luv, dpx * scale * float2(1, -1), dpy * scale * float2(1, -1)).rg;
+			dn = lerp(dn, float2(t.x * 2 - 1, 1 - t.y * 2), w);
+		}
+	}
+	if (tintTex) {
+		float2 tuv = p * tintXf.xy + tintXf.zw; tuv.y = 1 - tuv.y;
+		albedo *= Tex2D[NonUniformResourceIndex(tintTex)].SampleLevel(sClamp, tuv, 0).rgb * tintMul;
+	}
+	dn *= normalStrength;
+	float3 T = normalize(float3(1, 0, 0) - ng * ng.x), B = cross(ng, T);
+	n = normalize(ng + T * dn.x + B * dn.y);
+}
+
+GBufferOut PS(VsOut i, bool front : SV_IsFrontFace)
+{
+	Material m = LoadMaterial(i.mat);
+	if (m.mflags & 16) {
+		float3 ng = normalize(i.normal);
+		if (!front) ng = -ng;
+		float3 sa, sn; float sr;
+		Splat(m.albedoTex, i.wpos, ng, sa, sr, sn);
+		GBufferOut so;
+		so.albedo = float4(saturate(sa), 1);
+		so.normal = float4(EncodeNormal(sn), clamp(sr, 0.045, 1.0), 0);
+		so.emissive = 0;
+		return so;
+	}
+	float4 albedo = m.baseColor;
+	if (m.albedoTex) albedo *= Tex2D[NonUniformResourceIndex(m.albedoTex)].Sample(sWrap, i.uv);
+	if (m.mflags & 1) clip(albedo.a - m.alphaCutoff);
+	float3 n = normalize(i.normal);
+	if (!front) n = -n;
+	if (m.normalTex) {
+		float2 nt = Tex2D[NonUniformResourceIndex(m.normalTex)].Sample(sWrap, i.uv).rg * 2 - 1;
+		nt *= m.normalScale;
+		float3 tn = float3(nt, sqrt(saturate(1 - dot(nt, nt))));
+		float3 t = i.tangent.xyz;
+		t = normalize(t - n * dot(n, t));
+		float3 b = cross(n, t) * (i.tangent.w < 0 ? -1.0 : 1.0);
+		if (!front) b = -b;
+		n = normalize(t * tn.x + b * tn.y + n * tn.z);
+	}
+	float ao = 1, rough = m.roughness, metal = m.metallic;
+	if (m.ormTex) {
+		float3 orm = Tex2D[NonUniformResourceIndex(m.ormTex)].Sample(sWrap, i.uv).rgb;
+		if (m.mflags & 4) ao = orm.r;
+		rough *= orm.g; metal *= orm.b;
+	}
+	float3 em = m.emissive;
+	if (m.emissiveTex) em *= Tex2D[NonUniformResourceIndex(m.emissiveTex)].Sample(sWrap, i.uv).rgb;
+	GBufferOut o;
+	o.albedo = float4(albedo.rgb, ao);
+	// foliage (Blender Translucent BSDF): +8 in the metal channel, the lighting pass lets sun through the leaves
+	o.normal = float4(EncodeNormal(n), clamp(rough, 0.045, 1.0), saturate(metal) + ((m.mflags & 128) ? 8.0 : 0.0));
+	o.emissive = float4(em, 0);
+	return o;
+}
+
+// shadow depth (alpha-tested materials only; opaque uses a null pixel shader)
+void ShadowPS(VsOut i)
+{
+	Material m = LoadMaterial(i.mat);
+	float a = m.baseColor.a;
+	if (m.albedoTex) a *= Tex2D[NonUniformResourceIndex(m.albedoTex)].Sample(sWrap, i.uv).a;
+	clip(a - m.alphaCutoff);
+}
+
+// ---- FX pass: water and flowing water, drawn into the lit HDR scene (blend: rgb + dst * a)
+float3 FxSky(float3 d, float lod)
+{
+	if (indices2.x) {
+		float2 uv = float2(0.5 - atan2(d.y, d.x) / (2 * PI), 0.5 - asin(clamp(d.z, -1, 1)) / PI);
+		uint w, h, mips;
+		Tex2D[indices2.x].GetDimensions(0, w, h, mips);
+		return Tex2D[indices2.x].SampleLevel(sWrap, uv, min(lod, mips - 1.0)).rgb * skyParams.y;
+	}
+	return EvalSH(d) * PI;
+}
+// height fog as the lighting pass applies it (inscatter, opacity)
+float4 FxFog(float3 P, float3 V, float dist)
+{
+	if (fogParams.x <= 0) return 0;
+	float rayLen = max(dist - fogParams.w, 0);
+	float dz = P.z - camPos.z;
+	float f = fogParams.y;
+	float camDens = fogParams.x * exp(-f * (camPos.z - fogParams.z));
+	float fz = f * dz;
+	float lineInt = abs(fz) > 1e-4 ? (1 - exp(-fz)) / fz : 1 - 0.5 * fz;
+	float opacity = min(1 - exp(-camDens * lineInt * rayLen), fogColor.w);
+	float3 hd = normalize(float3(-V.xy, 0.05));
+	float3 inscatter = FxSky(hd, 8) * fogColor.rgb;
+	inscatter += sunColor.rgb * sunColor.w * pow(saturate(dot(-V, sunDir.xyz)), 8) * 0.25 * fogColor.rgb;
+	return float4(inscatter, opacity);
+}
+float WaveHeight(float2 p, float t, out float2 grad)
+{
+	// a few directional waves + two scrolling octaves of ripples (metres, seconds)
+	static const float4 W[6] = {
+		float4(0.80, 0.60, 0.55, 1.10), float4(-0.45, 0.89, 0.90, 1.50), float4(0.20, -0.98, 1.70, 2.10),
+		float4(-0.92, -0.38, 2.60, 2.90), float4(0.60, -0.80, 4.30, 3.70), float4(0.98, 0.20, 6.10, 4.30) };
+	float h = 0; grad = 0;
+	[unroll] for (int k = 0; k < 6; k++) {
+		float2 dir = W[k].xy; float f = W[k].z, sp = W[k].w;
+		float a = 0.035 / f;
+		float ph = dot(dir, p) * f + t * sp;
+		h += a * sin(ph);
+		grad += a * f * cos(ph) * dir;
+	}
+	return h;
+}
+float4 FxPS(VsOut i, bool front : SV_IsFrontFace) : SV_Target0
+{
+	float sceneD = Tex2D[indices0.w].Load(int3(i.pos.xy, 0)).r;
+	if (i.pos.z < sceneD) discard;                       // reversed Z: behind the scene
+	Material m = LoadMaterial(i.mat);
+	float3 V = normalize(camPos.xyz - i.wpos);
+	float t = projParams.w;
+	float3 L = sunDir.xyz, sunC = sunColor.rgb * sunColor.w;
+	float3 ng = normalize(i.normal);
+	if (dot(ng, V) < 0) ng = -ng;
+	if (m.mflags & 32) {
+		// ---- still water
+		float2 p = i.wpos.xy / 40.0;                     // metres
+		float2 g; WaveHeight(p, t, g);
+		float3 n = normalize(ng + float3(-g * m.normalScale * 4.0, 0) * saturate(ng.z * 2));
+		float NdV = saturate(dot(n, V));
+		float F = 0.02 + 0.98 * pow(1 - NdV, 5);
+		float3 R = reflect(-V, n);
+		R.z = abs(R.z);                                  // no reflections from below the horizon
+		float3 refl = FxSky(R, 1) * asfloat(indices2.z);
+		float3 H = normalize(L + V);
+		float a2 = max(m.roughness, 0.02); a2 *= a2;
+		float NdH = saturate(dot(n, H));
+		float D = a2 / (PI * pow(NdH * NdH * (a2 - 1) + 1, 2));
+		float3 spec = sunC * D * F * saturate(dot(n, L)) * 0.25;
+		// absorption through the water to the bottom
+		float thick = sceneD > 0 ? max(ViewDepth(sceneD) - ViewDepth(i.pos.z), 0) / 40.0 : 50.0;
+		float3 sigma = (1 - saturate(m.emissive)) * 1.2 + 0.15;
+		float3 Tr = exp(-sigma * thick);
+		float T = dot(Tr, 1.0 / 3);
+		float3 scatter = m.baseColor.rgb * (EvalSH(float3(0, 0, 1)) * PI + sunC * saturate(L.z) * 0.15);
+		float3 body = scatter * (1 - Tr);
+		float3 rgb = refl * F + spec + body * (1 - F);
+		float a = T * (1 - F);
+		float4 fog = FxFog(i.wpos, V, length(camPos.xyz - i.wpos));
+		return float4(lerp(rgb, fog.rgb * (1 - a), fog.a), a);
+	}
+	if (m.mflags & 64) {
+		// ---- flowing water sheet: alpha from the scrolling channels of the flow record
+		uint o = m.albedoTex;
+		uint4 h0 = BUF(materialBuf).Load4(o);
+		uint nl = min(h0.x, 8u);
+		float mul = asfloat(h0.z);
+		float frame = t * 24.0;
+		float2 uvB = float2(i.uv.x, 1 - i.uv.y);         // Blender UV
+		float a = 0;
+		[loop] for (uint li = 0; li < nl; li++) {
+			uint lo = o + 64 + li * 32;
+			uint4 x = BUF(materialBuf).Load4(lo);
+			float4 y = asfloat(BUF(materialBuf).Load4(lo + 16));
+			uint tex = x.x, chan = x.y; float2 sc = asfloat(x.zw); float2 sp = y.xy; uint op = asuint(y.z);
+			float v = 1;
+			if (tex) {
+				float2 uv = uvB * sc + sp * frame;
+				float4 c = Tex2D[NonUniformResourceIndex(tex)].Sample(sWrap, float2(uv.x, 1 - uv.y));
+				v = chan == 0 ? c.r : chan == 1 ? c.g : chan == 2 ? c.b : c.a;
+			}
+			a = op == 0 ? v : op == 1 ? a + v : a * v;
+		}
+		// softer than the raw sum (the Blender sheets fade out by vertex colour, which is not cooked): a gentler
+		// curve, and edge-on sheets fade away
+		a = saturate(a * mul);
+		a = a * a * (3 - 2 * a) * 0.85;
+		a *= saturate(abs(dot(normalize(i.normal), V)) * 3);
+		float3 light = EvalSH(ng) * PI + sunC * saturate(dot(ng, L)) / PI;
+		float3 col = m.baseColor.rgb * light * 0.8 + m.emissive;
+		float4 fog = FxFog(i.wpos, V, length(camPos.xyz - i.wpos));
+		col = lerp(col, fog.rgb, fog.a);
+		return float4(col * a, 1 - a);
+	}
+	return float4(0, 0, 0, 1);
+}
