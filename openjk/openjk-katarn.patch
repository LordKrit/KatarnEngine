+qboolean R_FogParmsMatch( int fog1, int fog2 )
+{
+	for ( int i = 0; i < 2; i++ )
+	{
+		if ( tr.world->fogs[fog1].parms.color[i] != tr.world->fogs[fog2].parms.color[i] )
+		{
+			return qfalse;
+		}
+	}
+	return qtrue;
+}
