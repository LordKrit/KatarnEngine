+//rww - RAGDOLL_BEGIN
+#define		GHOUL2_RAG_STARTED						0x0010
+#define		GHOUL2_RAG_FORCESOLVE					0x1000		//api-override, determine if ragdoll should be forced to continue solving even if it thinks it is settled
+//rww - RAGDOLL_END
