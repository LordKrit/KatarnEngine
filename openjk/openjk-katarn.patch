+		{
+			for ( int j = 0; j < 4; j++ )
+			{
+				assert( !Q_isnan(mSmoothBones[index].boneMatrix.matrix[i][j]));
+			}
+		}
+#endif// _DEBUG
+	}
+//rww - RAGDOLL_END
+
