+		BONE_ANIM_OVERRIDE_FREEZE|BONE_ANIM_BLEND,
+		1.0f, curTime, float(startFrame), 150, 0, true);
+
+	G2_ConstructGhoulSkeleton(ghoul2, curTime, false, params->scale);
