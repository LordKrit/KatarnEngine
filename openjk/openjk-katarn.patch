+void APIENTRY ktgl_MultiTexCoord2fARB(GLenum unit, GLfloat u, GLfloat v)
+{
+	int i = (unit == GL_TEXTURE1_ARB) ? 1 : 0;
+	s.tc[i][0] = u; s.tc[i][1] = v;
+}
