+/*
+=======================
+SV_QsortEntityNumbers
+=======================
+*/
+static int QDECL QsortDistance( const void *a, const void *b ) {
+	const float	&ea = ((CCollisionRecord*)a)->mDistance;
+	const float	&eb = ((CCollisionRecord*)b)->mDistance;
+
+	if ( ea < eb ) {
+		return -1;
+	}
+	return 1;
+}
