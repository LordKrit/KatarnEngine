+qboolean G2API_RagForceSolve(CGhoul2Info_v &ghoul2, qboolean force)
+{
+	assert(ghoul2.size());
+	CGhoul2Info *ghlInfo = &ghoul2[0];
+
+	if (!(ghlInfo->mFlags & GHOUL2_RAG_STARTED))
+	{ //can't do this if not in ragdoll
+		return qfalse;
+	}
+
+	if (force)
+	{
+		ghlInfo->mFlags |= GHOUL2_RAG_FORCESOLVE;
+	}
+	else
+	{
+		ghlInfo->mFlags &= ~GHOUL2_RAG_FORCESOLVE;
+	}
+
+	return qtrue;
